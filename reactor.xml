<!--
Standalone compatibility-verification reactor for the whole Apache-licensed ForwardMeasure stack
(see README.md's "Artifact compatibility" section and .github/workflows/platform-verify.yml,
which builds this file's module list, not pom.xml's). Deliberately not named pom.xml and
deliberately not a parent of anything and has no parent of its own - the whole point is that
nothing ever discovers this file by walking a <parent> chain. Run with:

    mvn -f reactor.xml -B clean install

This is never installed or deployed as a real artifact - it exists purely to drive a local
multi-repo build. See pom.xml's own <modules> comment for why the sibling repos used to be listed
there directly instead, and why that broke every Quarkus module's local build ecosystem-wide.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.forwardmeasure.platform</groupId>
  <artifactId>forwardmeasure-compatibility-reactor</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>ForwardMeasure Compatibility Reactor</name>
  <description>Local-build-only aggregator for the whole Apache-licensed ForwardMeasure stack - never installed or deployed</description>

  <modules>
    <module>.</module>
    <module>../forwardmeasure-testcontainers</module>
    <module>../forwardmeasure-database-migrations</module>
    <module>../forwardmeasure-jpa</module>
    <module>../forwardmeasure-object-storage</module>
    <module>../forwardmeasure-nlp</module>
    <module>../forwardmeasure-entity-matching</module>
    <module>../forwardmeasure-openworkflow</module>
    <module>../forwardmeasure-decision-engine</module>
    <module>../forwardmeasure-agent-os</module>
    <module>../forwardmeasure-platform-operations</module>
  </modules>
</project>
