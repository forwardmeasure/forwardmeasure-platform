    <module>forwardmeasure-platform-quarkus-bom</module>
    <module>forwardmeasure-platform-spring-bom</module>
    <module>forwardmeasure-platform-micronaut-bom</module>
    <module>forwardmeasure-platform-policy-maven-plugin</module>
    <module>forwardmeasure-platform-build-contract-tests</module>
    <module>forwardmeasure-platform-bom</module>
    <module>forwardmeasure-platform-compatibility-tests</module>
  </modules>

