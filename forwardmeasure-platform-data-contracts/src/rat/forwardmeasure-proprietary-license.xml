<!--
  Apache RAT configuration for FEI's proprietary license header. The module pom approves this family
  and denies the Apache License family, so a file without the ForwardMeasure header, or with an
  Apache header, fails the build.
-->
<rat-config>
	<families>
		<family id="FMPROP" name="ForwardMeasure Proprietary" />
	</families>
	<licenses>
		<license family="FMPROP" id="FMPROP" name="ForwardMeasure Proprietary License">
			<text>This file is part of ForwardMeasure Entity Intelligence and is
				proprietary and confidential.</text>
		</license>
	</licenses>
</rat-config>
