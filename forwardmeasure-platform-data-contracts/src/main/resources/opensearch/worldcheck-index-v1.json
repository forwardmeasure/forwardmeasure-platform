{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "name_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        },
        "name_phonetic_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding",
            "name_double_metaphone"
          ]
        }
      },
      "filter": {
        "name_double_metaphone": {
          "type": "phonetic",
          "encoder": "double_metaphone",
          "replace": false
        }
      },
      "normalizer": {
        "lowercase": {
          "type": "custom",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "entity_kind": {
        "type": "keyword"
      },
      "names": {
        "type": "nested",
        "properties": {
          "value": {
            "type": "text",
            "analyzer": "name_analyzer",
            "fields": {
              "standard": {
                "type": "text",
                "analyzer": "name_analyzer"
              },
              "keyword": {
                "type": "keyword",
                "normalizer": "lowercase",
                "ignore_above": 512
              },
              "phonetic": {
                "type": "text",
                "analyzer": "name_phonetic_analyzer",
                "search_analyzer": "name_phonetic_analyzer"
              }
            }
          },
          "name_type": {
            "type": "keyword"
          }
        }
      },
      "dates": {
        "type": "date",
        "format": "yyyy-MM-dd||strict_date_optional_time"
      },
      "nationalities": {
        "type": "keyword"
      },
      "countries": {
        "type": "keyword"
      },
      "location_country_codes": {
        "type": "keyword"
      },
      "locations": {
        "type": "nested",
        "properties": {
          "country_name": {
            "type": "text",
            "analyzer": "standard"
          },
          "country_code": {
            "type": "keyword"
          },
          "location_type": {
            "type": "keyword"
          },
          "city": {
            "type": "text"
          },
          "state_or_province": {
            "type": "text"
          }
        }
      },
      "identifiers": {
        "type": "nested",
        "properties": {
          "type": {
            "type": "keyword"
          },
          "value": {
            "type": "keyword"
          },
          "normalized_value": {
            "type": "keyword"
          }
        }
      },
      "uid": {
        "type": "keyword"
      },
      "source_data": {
        "type": "object",
        "dynamic": false,
        "properties": {
          "UPDATE CATEGORY": {
            "type": "keyword"
          }
        }
      },
      "title": {
        "type": "text"
      },
      "position": {
        "type": "text"
      },
      "place_of_birth": {
        "type": "text"
      },
      "further_information": {
        "type": "text"
      },
      "update_category": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "editor": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "pep_status": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "source_categories": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "source_subcategories": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "company_ids": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "linked_record_ids": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "keywords": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "external_sources": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "external_source_domains": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "pep_roles": {
        "type": "text"
      },
      "special_interest_categories": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "categories": {
        "type": "keyword",
        "ignore_above": 2048
      },
      "age": {
        "type": "integer"
      },
      "deceased": {
        "type": "boolean"
      },
      "entered_date": {
        "type": "date",
        "format": "strict_date"
      },
      "updated_date": {
        "type": "date",
        "format": "strict_date"
      },
      "age_as_of_date": {
        "type": "date",
        "format": "strict_date"
      },
      "date_details": {
        "type": "nested",
        "properties": {
          "value": {
            "type": "keyword"
          },
          "precision": {
            "type": "keyword"
          }
        }
      }
    }
  }
}
