<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.forwardmeasure.platform</groupId>
    <artifactId>forwardmeasure-platform</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>forwardmeasure-platform-bom</artifactId>
  <packaging>pom</packaging>
  <name>ForwardMeasure Platform BOM</name>

  <properties>
    <forwardmeasure.testcontainers.version>1.0.0</forwardmeasure.testcontainers.version>
    <forwardmeasure.database-migrations.version>1.0.0</forwardmeasure.database-migrations.version>
    <forwardmeasure.jpa.version>1.0.0</forwardmeasure.jpa.version>
    <forwardmeasure.object-storage.version>1.0.0</forwardmeasure.object-storage.version>
    <openworkflow.kafka-streams.version>0.1.0</openworkflow.kafka-streams.version>
    <entity-intelligence.version>0.2.0-SNAPSHOT</entity-intelligence.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.forwardmeasure.testcontainers</groupId>
        <artifactId>forwardmeasure-testcontainers-bom</artifactId>
        <version>${forwardmeasure.testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.forwardmeasure.database</groupId>
        <artifactId>forwardmeasure-database-migrations-bom</artifactId>
        <version>${forwardmeasure.database-migrations.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.forwardmeasure.jpa</groupId>
        <artifactId>forwardmeasure-jpa-bom</artifactId>
        <version>${forwardmeasure.jpa.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.forwardmeasure.objectstorage</groupId>
        <artifactId>forwardmeasure-object-storage-bom</artifactId>
        <version>${forwardmeasure.object-storage.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- The OKS parent currently exposes the complete OKS dependency-management surface. -->
      <dependency>
        <groupId>com.forwardmeasure.openworkflow</groupId>
        <artifactId>openworkflow-kafka-streams-parent</artifactId>
        <version>${openworkflow.kafka-streams.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Entity Intelligence currently exposes its dependency-management surface from its parent. -->
      <dependency>
        <groupId>com.forwardmeasure.entityintelligence</groupId>
        <artifactId>entity-intelligence-parent</artifactId>
        <version>${entity-intelligence.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <flattenMode>bom</flattenMode>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
