    "findings": [
      {
        "finding": "Screening transform/export HTTP 500 on all frameworks",
        "cause": "Export mapped the lazy monitored-population association after its transaction closed.",
        "repair": "Initialize all associations needed by the run view inside the export transaction; assert monitored_population_id in every framework export test."
      },
      {
        "finding": "Entity-deletion fixtures fail to load schema contracts",
        "cause": "The migrations fixture artifact did not carry its canonical platform contract resources.",
        "repair": "Add the platform data-contracts runtime dependency and a regression that provisions the real deletion fixture. Deletion tests now pass on all three frameworks."
      },
      {
        "finding": "EntityReadIntegrationTest missing population-contract services",
        "cause": "ManagedServiceSession test-support maps omitted the services used by shared population-contract fixtures.",
        "repair": "Register all four services in all three framework fixtures; Quarkus required the same fix once deletion startup was restored."
      },
      {
        "finding": "Missing source contracts test",
        "cause": "The old test omitted the optional first input definition; OpenAPI permits creating a population before registering input contracts.",
        "repair": "Retain optional population creation, cover it positively, and require 400 when a supplied input definition omits its required source contracts."
      },
      {
        "finding": "Spring revision lifecycle connection refused",
        "cause": "Two HTTP delete requests used the default client port instead of the assigned test port.",
        "repair": "Apply the injected port to both requests."
      },
      {
        "finding": "Quarkus monitored-population list test",
        "cause": "An explicitly empty query bound to null and bypassed the generated size constraint. This was not cross-test fixture leakage.",
        "repair": "Inspect query presence in the raw request URI and enforce the shared 1-to-200-character constraint on all hosts."
      },
      {
        "finding": "FARCH-07 application dependency on repositories",
        "cause": "A repository-owned summary type leaked through the domain service into the application listing type.",
        "repair": "Define the summary in the domain service and map repository counts at that boundary. All eight reactor architecture tests pass."
      }
    ]
  },
