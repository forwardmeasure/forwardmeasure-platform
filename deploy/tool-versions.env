#
# The command-line tools every deploy and CI run uses, and the one place their versions are set.
# CI installs exactly these; the install scripts refuse to run with anything else, including a
# binary built for another CPU architecture (an emulated helmfile made every install several
# times slower without any error).
#
# Raising a version: render every helmfile with the old and new binaries and compare (byte-identical
# output for Helmfile 1.3.2 -> 1.8.1 on 2026-10-12), then change it here.
HELM_VERSION=4.2.2
HELMFILE_VERSION=1.8.1
HELM_DIFF_VERSION=3.15.0
