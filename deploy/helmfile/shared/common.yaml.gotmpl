# SHARED LAYER - the single source of truth for every value more than one repository deploys with.
# Every product helmfile (forwardmeasure-openworkflow, -data-streaming, -entity-intelligence,
# -decision-engine) and this repository's own helmfile load the files in this directory directly,
# by relative path from the sibling checkout - nothing is copied into the product repositories.
#
#   common.yaml.gotmpl          environment-independent: shared namespaces, in-cluster endpoints,
#                               identity realm/client, Gateway API version, platform-delivered
#                               Secret names
#   chart-versions.yaml         chart pins used by more than one repository
#   image-versions.yaml         image pins used by more than one repository (digest-synced by
#                               scripts/sync-image-digests.sh)
#   clusters/<env>.yaml.gotmpl  facts about one real environment/cluster: domain, gateway IP and
#                               hostnames, cloud project/region/cluster, Cloud SQL instance
#
# Each file is self-contained: helmfile renders every environment values file in isolation (a
# values file cannot read values loaded before it - verified on helmfile 1.3.2), so everything
# derived (hosts, URLs) is derived inside the file that owns its inputs.
#
# Consumers load these files LAST in their environment values lists, so a shared value always
# wins over a stale product-local copy of the same key.
{{- $sharedDir := .Values | get "deploymentSharedDir" "." }}
{{- $selection := exec "python3" (list (printf "%s/../../scripts/deployment-selection.py" $sharedDir) "--environment" .Environment.Name) | fromJson }}
{{- /* Every product namespace carries the forwardmeasure- prefix (docs/technical-vision.md 5.4). */}}
{{- $prefix := "forwardmeasure-" }}
{{- $namespaces := dict
      "platform" "forwardmeasure-platform"
      "istio" "istio-system"
      "openworkflow" "forwardmeasure-openworkflow"
      "keycloak" "keycloak"
      "registry" "apicurio-registry"
      "kafka" "kafka"
      "openSearch" "opensearch-cluster"
      "valkey" "valkey"
      "dataStreaming" (printf "%sdata-streaming" $prefix)
      "entityIntelligence" (printf "%sentity-intelligence" $prefix)
      "decisionEngine" (printf "%sdecision-engine" $prefix)
      "agentEnsemble" (printf "%sagent-ensemble" $prefix)
      "docling" "docling-serve"
      "modelServing" "kserve-serving" }}
{{- /* Environment value templates render independently. Read the declared cluster facts here,
then apply explicit state-value overrides; do not depend on another values file's load order. */}}
{{- $clusterFile := printf "%s/clusters/%s.yaml.gotmpl" $sharedDir .Environment.Name }}
{{- if not (isFile $clusterFile) }}{{ $clusterFile = printf "%s/clusters/base.yaml.gotmpl" $sharedDir }}{{ end }}
{{- $cluster := tpl (readFile $clusterFile) (dict) | fromYaml }}
{{- $database := mergeOverwrite (dig "platform" "databases" (dict) $cluster) (dig "platform" "databases" (dict) .Values) }}
{{- $admission := exec "python3" (list (printf "%s/../../scripts/database-admission-capacity.py" $sharedDir)
      "--instance-identity" (required "cluster platform.databases.instanceIdentity is required" (get "instanceIdentity" "" $database))
      "--slots" (printf "%v" (get "admissionSlots" "" $database))
      "--buckets" (printf "%v" (get "guardBuckets" "" $database))) | fromJson }}
{{- $framework := $selection.framework }}
{{- $engine := $selection.engine }}
{{- $enableFde := $selection.enableFde }}
{{- /* The platform's Apicurio Registry (environments/base.yaml.gotmpl registry.name); the
operator names its API Service <name>-app-service. */}}
{{- $registryName := "platform-registry" }}
{{- $keycloakService := "keycloak-internal" }}
{{- $keycloakPort := 8080 }}
{{- $keycloakRealm := "forwardmeasure" }}
{{- $kafkaClusterName := "kafka-cluster" }}
{{- $kafkaPort := 9092 }}
{{- $openSearchService := "opensearch-cluster-master" }}
{{- $openSearchPort := 9200 }}
{{- $keycloakUrl := printf "http://%s.%s.svc.cluster.local:%d" $keycloakService $namespaces.keycloak $keycloakPort }}
{{- $issuer := printf "%s/realms/%s" $keycloakUrl $keycloakRealm }}
{{- /* fei's logical API address - its OpenAPI document's servers: URL (entity-intelligence-api.yaml). */}}
{{- $entityIntelligenceApiUrl := "https://api.entity-intelligence.forwardmeasure.internal" }}
{{- $entityIntelligenceBaseUrls := dict
      "ingestion" (printf "http://entity-intelligence-ingestion-service.%s.svc.cluster.local" $namespaces.entityIntelligence)
      "resolution" (printf "http://entity-intelligence-resolution-service.%s.svc.cluster.local" $namespaces.entityIntelligence)
      "screening" (printf "http://entity-intelligence-screening-service.%s.svc.cluster.local" $namespaces.entityIntelligence) }}
{{- /* fei's top-level API paths -> the service implementing them (its *-service-jaxrs modules). */}}
{{- $entityIntelligencePathOwners := dict
      "/source-feed-profiles" "ingestion"
      "/reference-populations" "ingestion"
      "/monitored-populations" "ingestion"
      "/monitored-population-memberships" "ingestion"
      "/ingestion-pipelines" "ingestion"
      "/ingestion" "ingestion"
      "/lifecycle-operations" "ingestion"
      "/lifecycle-storage" "ingestion"
      "/monitored-population-archives" "ingestion"
      "/storage-orphans/archives" "ingestion"
      "/storage-orphans/evidence" "resolution"
      "/internal/reference-populations" "ingestion"
      "/entities/{entityId}/suppress" "ingestion"
      "/entities/{entityId}/suppression-preview" "ingestion"
      "/lifecycle-policy" "ingestion"
      "/source-records" "ingestion"
      "/internal/lifecycle-operations" "ingestion"
      "/me/permissions" "resolution"
      "/entities" "resolution"
      "/candidate-entities" "resolution"
      "/assertions" "resolution"
      "/llm-prompts" "resolution"
      "/dossiers" "resolution"
      "/investigations" "resolution"
      "/screening" "screening" }}
{{- /* The platform's ml-serving stage (helmfiles/50-ml-serving.yaml.gotmpl): docling-serve's
<release>-<chart> Service on 5001, and the named-entity-recognition release's KServe predictor
(releases/named-entity-recognition/model.values.yaml names the model). */}}
{{- $doclingConvertUrl := printf "http://docling-docling-serve.%s.svc.cluster.local:5001/v1/convert/source" $namespaces.docling }}
{{- $nerExtractionsUrl := printf "http://ner-gliner-medium-v2-1-predictor.%s.svc.cluster.local/api/v1/named-entity-recognition/extractions" $namespaces.modelServing }}
{{- /* Language-model profiles - each a model configuration this environment offers - are cluster
facts (clusters/<env>.yaml.gotmpl platform.llmProfiles); each product uses the one named in
platform.llmProfileAssignments. Every profile's API key is the platform credential
platform-llm-<profile>-api-key. wireFormat is the API the url speaks: openai-chat-completions (any
OpenAI-compatible chat/completions endpoint, the default) or anthropic-messages (Anthropic's
Messages API, with structured outputs). */}}
{{- $wireFormats := list "openai-chat-completions" "anthropic-messages" }}
{{- $llmProfiles := dict }}
{{- range $name, $profile := (dig "platform" "llmProfiles" (dict) $cluster) }}
{{-   $wireFormat := dig "wireFormat" "openai-chat-completions" $profile }}
{{-   if not (has $wireFormat $wireFormats) }}
{{-     fail (printf "platform.llmProfiles.%s.wireFormat %q is not one of %s" $name $wireFormat (join ", " $wireFormats)) }}
{{-   end }}
{{-   $_ := set $llmProfiles $name (dict
        "url" (dig "url" "" $profile)
        "wireFormat" $wireFormat
        "modelId" (dig "modelId" "" $profile)
        "requestParameters" (dig "requestParameters" (dict) $profile)
        "apiKeyCredential" (printf "platform-llm-%s-api-key" $name)) }}
{{- end }}
{{- $llmProfileAssignments := dig "platform" "llmProfileAssignments" (dict) $cluster }}
{{- range $use, $name := $llmProfileAssignments }}
{{-   if not (hasKey $llmProfiles $name) }}
{{-     fail (printf "platform.llmProfileAssignments.%s names llm profile %q, which platform.llmProfiles does not define" $use $name) }}
{{-   end }}
{{- end }}
{{- /* Every tenant's workflows may call the platform's own services: the ml-serving stage, the
model of every profile and (below) every service a logical API address is routed to. fowf's operation
adapter allows these hosts for every tenant (OPENWORKFLOW_HTTP_EGRESS_ALLOWLIST, keyed by the tenant's
DID); an operator's own destinations are added per tenant on top. */}}
{{- $workflowEgressHosts := list (urlParse $doclingConvertUrl).hostname (urlParse $nerExtractionsUrl).hostname }}
{{- range $name, $profile := $llmProfiles }}
{{-   if $profile.url }}
{{-     $workflowEgressHosts = append $workflowEgressHosts (urlParse $profile.url).hostname }}
{{-   end }}
{{- end }}
{{- $httpEndpointRoutes := list }}
{{- range $path, $owner := $entityIntelligencePathOwners }}
{{- /* URI-safe placeholders let older adapters parse the map during a rolling upgrade. The new matcher decodes only whole-segment template names. */}}
{{-   $wirePath := replace "{" "%7B" $path | replace "}" "%7D" }}
{{-   $httpEndpointRoutes = append $httpEndpointRoutes (printf "%s%s=%s%s" $entityIntelligenceApiUrl $wirePath (index $entityIntelligenceBaseUrls $owner) $wirePath) }}
{{- end }}
{{- /* The adapter routes a logical API address first and then checks the real destination against the
allowlist, so every routed service is a platform host too (fei's services, for workflows calling fei's
API - Indexical's admission among them). */}}
{{- range $route := $httpEndpointRoutes }}
{{-   $workflowEgressHosts = append $workflowEgressHosts (urlParse (index (splitList "=" $route) 1)).hostname }}
{{- end }}
platform:
  branding:
    displayName: {{ $selection.displayName | quote }}
  products:
    decisionEngine:
      enabled: {{ $enableFde }}
  # quarkus | spring | micronaut. Every product (forwardmeasure-openworkflow, -entity-intelligence,
  # -data-streaming, -decision-engine) deploys each of its services in this framework: it picks the
  # image flavor, and the java-microservice chart derives probe paths and datasource env from it.
  # Service names never carry the framework, so no address anywhere changes when it does.
  framework: {{ $framework }}
  # kafka-streams | pekko-postgresql | pekko-cassandra. The one workflow engine
  # forwardmeasure-openworkflow deploys; execution-management admits every execution to it. Chosen
  # here at platform deploy time, like framework - a different engine is a different deployment.
  engine: {{ $engine }}
  namespaces:
    {{- toYaml $namespaces | nindent 4 }}
  gatewayApi:
    version: v1.5.1
  databases:
    lifecycleAdmission:
      {{- toYaml $admission | nindent 6 }}
    # The platform control-plane database on the shared Postgres (Cloud SQL) instance: holds
    # tenant_registry (tenant -> tenant-database mapping) and Pekko's cluster-wide coordinator store.
    # Created by Terraform (openworkflow-k8s-setup on gcp-openworkflow-prod, k8s-infrastructure/
    # opentofu/gcp on a new cluster) or by the in-cluster Postgres locally; migrated by
    # forwardmeasure-openworkflow's migrations Jobs. Every product runtime reads tenant_registry from
    # it to route each request to that tenant's own database (forwardmeasure_<alias>, one schema per
    # product). Products never have a database of their own. The name shares the tenant databases'
    # forwardmeasure_ prefix, so forwardmeasure-jpa's TenantDatabase reserves the alias
    # "control_plane" - no tenant can ever be given this database.
    controlPlane: forwardmeasure_control_plane
    # Runtime roles created/rotated by forwardmeasure-openworkflow's migrations stage and used by
    # each product's servers - the name is a contract between that Job and the Secrets
    # platform-secrets delivers.
    runtimeRoles:
      decisionEngine: decision_engine
      entityIntelligence: entityintelligence
      # forwardmeasure-data-streaming's continuous Pekko workers: its journal schema in each tenant
      # database (data-streaming-migrations).
      dataStreaming: datastreaming
      # forwardmeasure-agent-ensemble's agents (Indexical's extraction registry): its
      # agent_ensemble schema in each tenant database (agent-ensemble-migrations).
      agentEnsemble: agent_ensemble
  identity:
    realm: {{ $keycloakRealm }}
    # The org-wide public client every product's organization/tenant-claim verification points at.
    organizationClientId: forwardmeasure-public
    # The platform's bootstrap administrator (the keycloak release creates it) - products grant it
    # their tenant roles.
    platformAdminUsername: platform-admin
    # Human administrator membership is limited to the first configured tenant by default.
    administratorTenantAliases: []
    administratorAllTenants: false
    serviceClients:
      openworkflow:
        clientId: openworkflow
        name: OpenWorkflow Service Client
        secretKey: OPENWORKFLOW_CLIENT_SECRET
        secretRemoteKey: platform-openworkflow-client-secret
        authorizationServicesEnabled: true
        realmRoles:
        - workflow-author
        - workflow-execution-controller
        - workflow-auditor
        - workflow-administrator
        audiences:
        - openworkflow-api
        organizationClaim: false
        enabled: true
      decisionEngine:
        clientId: decisionengine
        name: Decision Engine Resource Server
        secretKey: DECISION_ENGINE_CLIENT_SECRET
        secretRemoteKey: platform-decision-engine-client-secret
        authorizationServicesEnabled: true
        organizationClaim: false
        enabled: {{ $enableFde }}
      decisionEngineEvaluator:
        clientId: openworkflow-decision-evaluator
        name: OpenWorkflow Decision Evaluator
        secretKey: DECISION_ENGINE_EVALUATOR_CLIENT_SECRET
        secretRemoteKey: platform-decision-engine-evaluator-client-secret
        authorizationServicesEnabled: false
        organizationClaim: true
        audiences: [decision-engine-api]
        capabilityPack: decision-engine
        tenantRoles: [decision-evaluator]
        enabled: {{ $enableFde }}
      platformOperator:
        clientId: openworkflow-platform-operator
        name: OpenWorkflow Platform Operator
        secretKey: OPENWORKFLOW_PLATFORM_OPERATOR_CLIENT_SECRET
        secretRemoteKey: platform-openworkflow-platform-operator-client-secret
        realmRoles:
        - openworkflow-platform-operator
        authorizationServicesEnabled: false
        organizationClaim: false
        enabled: true
      workflowPublisher:
        clientId: openworkflow-workflow-publisher
        name: OpenWorkflow Workflow Publisher
        secretKey: OPENWORKFLOW_WORKFLOW_PUBLISHER_CLIENT_SECRET
        secretRemoteKey: platform-openworkflow-workflow-publisher-client-secret
        organizationClaim: true
        tenantRoles:
        - workflow-author
        authorizationServicesEnabled: false
        enabled: true
        capabilityPack: openworkflow
      apicurioReader:
        clientId: openworkflow-definition-management-apicurio-reader
        name: OpenWorkflow Apicurio Reader
        secretKey: OPENWORKFLOW_APICURIO_READER_CLIENT_SECRET
        secretRemoteKey: platform-openworkflow-apicurio-reader-client-secret
        authorizationServicesEnabled: false
        organizationClaim: false
        enabled: true
      dataStreaming:
        clientId: datastreaming
        name: Data Streaming Launcher
        secretKey: DATA_STREAMING_CLIENT_SECRET
        secretRemoteKey: platform-data-streaming-client-secret
        organizationClaim: true
        tenantRoles:
        - workflow-execution-controller
        authorizationServicesEnabled: true
        enabled: true
        capabilityPack: openworkflow
      entityIntelligence:
        clientId: entityintelligence
        name: Entity Intelligence Resource Server
        secretKey: ENTITY_INTELLIGENCE_CLIENT_SECRET
        secretRemoteKey: platform-entity-intelligence-client-secret
        authorizationServicesEnabled: true
        organizationClaim: true
        enabled: true
      entityIntelligenceLauncher:
        clientId: entity-intelligence-launcher
        name: Entity Intelligence Launcher
        secretKey: ENTITY_INTELLIGENCE_LAUNCHER_CLIENT_SECRET
        secretRemoteKey: platform-entity-intelligence-launcher-client-secret
        organizationClaim: true
        tenantRoles:
        - workflow-operator
        authorizationServicesEnabled: false
        enabled: true
        capabilityPack: openworkflow
      entityIntelligenceIngestionWorker:
        clientId: entity-intelligence-ingestion-worker
        name: Entity Intelligence Ingestion Worker
        secretKey: ENTITY_INTELLIGENCE_INGESTION_WORKER_CLIENT_SECRET
        secretRemoteKey: platform-entity-intelligence-ingestion-worker-client-secret
        organizationClaim: true
        authorizationServicesEnabled: false
        enabled: true
        tenantRoles:
        - fei-ingestion-worker-caller
        - entity-intelligence-worker
        capabilityPack: entity-intelligence
      entityIntelligenceScreeningWorker:
        clientId: entity-intelligence-screening-worker
        name: Entity Intelligence Screening Worker
        secretKey: ENTITY_INTELLIGENCE_SCREENING_WORKER_CLIENT_SECRET
        secretRemoteKey: platform-entity-intelligence-screening-worker-client-secret
        organizationClaim: true
        authorizationServicesEnabled: false
        enabled: true
        tenantRoles:
        - fei-screening-worker-caller
        - entity-intelligence-worker
        capabilityPack: entity-intelligence
      # forwardmeasure-agent-ensemble's Indexical: its AuthZEN resource server (the indexical
      # resources/scopes/permissions of its capability pack, reconciled per tenant by fowf's tenant
      # administration) and the identity the service evaluates decisions with.
      indexical:
        clientId: indexical
        name: Indexical Resource Server
        secretKey: INDEXICAL_CLIENT_SECRET
        secretRemoteKey: platform-indexical-client-secret
        authorizationServicesEnabled: true
        organizationClaim: true
        enabled: true
      # Indexical's FEI caller: the workflow's admitResults step calls FEI's admitInformationExtraction
      # with a token the operation adapter mints for this client (indexical-fei-admission-token).
      # A member of FEI's capability pack holding only indexical-evidence-admission-caller.
      indexicalEvidenceAdmission:
        clientId: indexical-evidence-admission
        name: Indexical Evidence Admission
        secretKey: INDEXICAL_EVIDENCE_ADMISSION_CLIENT_SECRET
        secretRemoteKey: platform-indexical-evidence-admission-client-secret
        organizationClaim: true
        authorizationServicesEnabled: false
        enabled: true
        tenantRoles:
        - indexical-evidence-admission-caller
        capabilityPack: entity-intelligence
      # Indexical's OpenWorkflow caller: starts and observes its extraction executions in every
      # tenant (workflow-operator), like FEI's launcher.
      indexicalLauncher:
        clientId: indexical-launcher
        name: Indexical Launcher
        secretKey: INDEXICAL_LAUNCHER_CLIENT_SECRET
        secretRemoteKey: platform-indexical-launcher-client-secret
        organizationClaim: true
        tenantRoles:
        - workflow-operator
        authorizationServicesEnabled: false
        enabled: true
        capabilityPack: openworkflow
    # The platform's own DID method (did:<didMethod>:...) - the only place it is named. Products
    # read it as FORWARDMEASURE_DID_METHOD (forwardmeasure-jpa's PlatformDids): workflow bundles are
    # did:<method>:bundle:<domain> and their documents DID URLs under that; resolved entities are
    # did:<method>:entity:<tenantId>:<uuid>.
    didMethod: fwm
  # Secrets forwardmeasure-platform's platform-secrets release delivers into product namespaces -
  # the name is the contract between this repository (producer) and the product (consumer).
  secrets:
    imagePull: docker-io-credentials
    # fowf's own bundle: OPENWORKFLOW_CLIENT_SECRET/OPENWORKFLOW_RUNTIME_DATABASE_PASSWORD/
    # OPENWORKFLOW_ADMIN_DATABASE_PASSWORD, synced into forwardmeasure-openworkflow's namespace.
    openworkflowIdentity: openworkflow-identity-credentials
    # The service-client credentials openworkflow-platform-clients' Job creates in Keycloak (platform
    # operator, workflow publisher, definition-resource auth). Owned by that Job alone: it can't share
    # openworkflowIdentity, which its ExternalSecret owns and restores, dropping any key it didn't put.
    openworkflowPlatformClients: openworkflow-platform-clients
    # Narrow, dedicated secrets carrying ONLY the Keycloak admin credential (KC_BOOTSTRAP_ADMIN_*),
    # synced into each product's own namespace for its own bootstrap Job to create/grant its own
    # Keycloak client(s) - deliberately NOT the openworkflowIdentity bundle, which those products
    # have no business ever holding.
    dataStreamingKeycloakAdmin: data-streaming-keycloak-admin
    entityIntelligenceKeycloakAdmin: entity-intelligence-keycloak-admin
    # Same OpenSearch username/password as the platform's own admin credential, delivered into
    # forwardmeasure-entity-intelligence's namespace (a secretKeyRef can't cross namespaces).
    entityIntelligenceOpenSearch: entity-intelligence-opensearch-credentials
    # entity-intelligence's server credentials: username/password of its runtime role plus
    # db-cloud-sql-instance for its services' Cloud SQL Auth Proxy sidecars. Deliberately separate
    # from entity-intelligence-credentials, which its own Keycloak bootstrap Job writes.
    entityIntelligenceDatabase: entity-intelligence-database-credentials
    # decision-engine's server credentials: username/password of its runtime role plus
    # db-cloud-sql-instance for its Cloud SQL Auth Proxy sidecar (one Secret, both consumers).
    decisionEngineDatabase: decision-engine-database-credentials
    # data-streaming's journal credentials: password of its runtime role plus db-cloud-sql-instance
    # for the Cloud SQL Auth Proxy sidecar beside each continuous Pekko worker.
    dataStreamingDatabase: data-streaming-database-credentials
    # forwardmeasure-agent-ensemble's server credentials (agent_ensemble role + Cloud SQL instance).
    agentEnsembleDatabase: agent-ensemble-database-credentials
    # The shared Valkey's password (its single default ACL user), for decision-engine's fact window.
    decisionEngineValkey: decision-engine-valkey-auth
  endpoints:
    keycloak:
      host: {{ printf "%s.%s.svc.cluster.local" $keycloakService $namespaces.keycloak }}
      url: {{ $keycloakUrl }}
      realm: {{ $keycloakRealm }}
      issuer: {{ $issuer }}
      tokenUrl: {{ printf "%s/protocol/openid-connect/token" $issuer }}
    kafka:
      clusterName: {{ $kafkaClusterName }}
      bootstrapServers: {{ printf "%s-kafka-bootstrap.%s.svc.cluster.local:%d" $kafkaClusterName $namespaces.kafka $kafkaPort }}
    openSearch:
      # HTTPS - the cluster enables TLS on its HTTP layer (releases/opensearch-cluster).
      endpoint: {{ printf "https://%s.%s.svc.cluster.local:%d" $openSearchService $namespaces.openSearch $openSearchPort }}
    valkey:
      host: {{ printf "valkey.%s.svc.cluster.local" $namespaces.valkey }}
    # The platform's Apicurio Registry, in-cluster (its NetworkPolicy admits fowf's namespace).
    # Products publish the API documents their workflows reference here (the workflow bundle's
    # resources); fowf's definition-management fetches them at publication, so its resource
    # allowlist includes this host.
    registry:
      host: {{ printf "%s-app-service.%s.svc.cluster.local" $registryName $namespaces.registry }}
      apiUrl: {{ printf "http://%s-app-service.%s.svc.cluster.local:8080/apis/registry/v3" $registryName $namespaces.registry }}
    # fowf's own REST services - deployed by forwardmeasure-openworkflow, but every product calls them.
    openworkflow:
      # java-microservice Services listen on port 80 (targetPort 8080), hence no port.
      executionBaseUrl: {{ printf "http://openworkflow-execution-management.%s.svc.cluster.local" $namespaces.openworkflow }}
      definitionBaseUrl: {{ printf "http://openworkflow-definition-management.%s.svc.cluster.local" $namespaces.openworkflow }}
      humanTaskBaseUrl: {{ printf "http://openworkflow-human-task-management.%s.svc.cluster.local" $namespaces.openworkflow }}
    # fei's REST services - deployed by forwardmeasure-entity-intelligence; apiUrl is the logical
    # address its OpenAPI document names, routed to these by httpEndpointRoutes below.
    entityIntelligence:
      apiUrl: {{ $entityIntelligenceApiUrl }}
      ingestionBaseUrl: {{ $entityIntelligenceBaseUrls.ingestion }}
      resolutionBaseUrl: {{ $entityIntelligenceBaseUrls.resolution }}
      screeningBaseUrl: {{ $entityIntelligenceBaseUrls.screening }}
    # decision-engine's gRPC service, as workflows name it (`call: grpc`, `with.service.host`) and as
    # fowf's operation adapter allowlists it (OPENWORKFLOW_PLATFORM_GRPC_ENDPOINTS) - one value so the
    # two can never differ. Deliberately <service>.<namespace>.svc, without .cluster.local: the
    # workflow DSL schema caps a gRPC host at 63 characters (its per-label pattern is applied to the
    # whole host), and the cluster's DNS search path resolves the short form unchanged.
    decisionEngine:
      grpcHost: {{ printf "decision-engine.%s.svc" $namespaces.decisionEngine }}
      grpcPort: 9000
    # The platform's ml-serving stage, which products' workflows call: Docling document conversion
    # and the GLiNER named-entity-recognition model.
    docling:
      convertUrl: {{ $doclingConvertUrl }}
    namedEntityRecognition:
      extractionsUrl: {{ $nerExtractionsUrl }}
  # Language-model profiles (from clusters/<env>.yaml.gotmpl): name -> url (the full endpoint URL),
  # wireFormat (openai-chat-completions | anthropic-messages), modelId, requestParameters
  # (model-specific settings merged into every request body) and apiKeyCredential (the platform
  # credential holding its key).
  llmProfiles:
    {{- toYaml $llmProfiles | nindent 4 }}
  # Which profile each product use runs on - one per product per deployment.
  llmProfileAssignments:
    {{- toYaml $llmProfileAssignments | nindent 4 }}
  # Hosts every tenant's workflows may call through fowf's operation adapter: the ml-serving stage
  # and every profile's model.
  workflowEgress:
    platformHosts:
      {{- toYaml (uniq $workflowEgressHosts) | nindent 6 }}
  # logical=physical;... - where each product's logical API address (an OpenAPI document's
  # servers: URL) is served in-cluster, for fowf's operation adapter
  # (OPENWORKFLOW_ADAPTER_HTTP_ENDPOINT_ROUTES, HttpEndpointRoutes: longest prefix at a path
  # boundary wins). fei is routed per top-level path, to the service that implements it.
  httpEndpointRoutes: {{ join ";" $httpEndpointRoutes | quote }}
