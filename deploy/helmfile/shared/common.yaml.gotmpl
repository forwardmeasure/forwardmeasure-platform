# SHARED LAYER - the single source of truth for every value more than one repository deploys with.
# Every product helmfile (forwardmeasure-openworkflow, -data-streaming, -entity-intelligence,
# -decision-engine) and this repository's own helmfile load the files in this directory directly,
# by relative path from the sibling checkout - nothing is copied into the product repositories.
#
#   common.yaml.gotmpl          environment-independent: shared namespaces, in-cluster endpoints,
#                               identity realm/client, Gateway API version, platform-delivered
#                               Secret names
#   chart-versions.yaml         chart pins used by more than one repository
#   image-versions.yaml         image pins used by more than one repository (digest-synced by
#                               scripts/sync-image-digests.sh)
#   clusters/<env>.yaml.gotmpl  facts about one real environment/cluster: domain, gateway IP and
#                               hostnames, cloud project/region/cluster, Cloud SQL instance
#
# Each file is self-contained: helmfile renders every environment values file in isolation (a
# values file cannot read values loaded before it - verified on helmfile 1.3.2), so everything
# derived (hosts, URLs) is derived inside the file that owns its inputs.
#
# Consumers load these files LAST in their environment values lists, so a shared value always
# wins over a stale product-local copy of the same key.
{{- $namespaces := dict
      "istio" "istio-system"
      "openworkflow" "forwardmeasure-openworkflow"
      "keycloak" "keycloak"
      "registry" "apicurio-registry"
      "kafka" "kafka"
      "openSearch" "opensearch-cluster"
      "valkey" "valkey"
      "dataStreaming" "data-streaming"
      "entityIntelligence" "entity-intelligence"
      "decisionEngine" "decision-engine" }}
{{- /* The one framework every product's services are deployed in - see platform.framework below. */}}
{{- $framework := "quarkus" }}
{{- if not (has $framework (list "quarkus" "spring" "micronaut")) }}
{{-   fail (printf "platform framework must be quarkus, spring or micronaut, not %q" $framework) }}
{{- end }}
{{- /* The one workflow engine forwardmeasure-openworkflow runs - see platform.engine below. */}}
{{- $engine := "kafka-streams" }}
{{- if not (has $engine (list "kafka-streams" "pekko-postgresql" "pekko-cassandra")) }}
{{-   fail (printf "platform engine must be kafka-streams, pekko-postgresql or pekko-cassandra, not %q" $engine) }}
{{- end }}
{{- /* The platform's Apicurio Registry (environments/base.yaml.gotmpl registry.name); the
operator names its API Service <name>-app-service. */}}
{{- $registryName := "platform-registry" }}
{{- $keycloakService := "keycloak-internal" }}
{{- $keycloakPort := 8080 }}
{{- $keycloakRealm := "forwardmeasure" }}
{{- $kafkaClusterName := "kafka-cluster" }}
{{- $kafkaPort := 9092 }}
{{- $openSearchService := "opensearch-cluster-master" }}
{{- $openSearchPort := 9200 }}
{{- $keycloakUrl := printf "http://%s.%s.svc.cluster.local:%d" $keycloakService $namespaces.keycloak $keycloakPort }}
{{- $issuer := printf "%s/realms/%s" $keycloakUrl $keycloakRealm }}
{{- /* fei's logical API address - its OpenAPI document's servers: URL (entity-intelligence-api.yaml). */}}
{{- $entityIntelligenceApiUrl := "https://api.entity-intelligence.forwardmeasure.internal" }}
{{- $entityIntelligenceBaseUrls := dict
      "ingestion" (printf "http://entity-intelligence-ingestion-service.%s.svc.cluster.local" $namespaces.entityIntelligence)
      "resolution" (printf "http://entity-intelligence-resolution-service.%s.svc.cluster.local" $namespaces.entityIntelligence)
      "screening" (printf "http://entity-intelligence-screening-service.%s.svc.cluster.local" $namespaces.entityIntelligence) }}
{{- /* fei's top-level API paths -> the service implementing them (its *-service-jaxrs modules). */}}
{{- $entityIntelligencePathOwners := dict
      "/source-feed-profiles" "ingestion"
      "/reference-populations" "ingestion"
      "/ingestion-pipelines" "ingestion"
      "/ingestion" "ingestion"
      "/entities" "resolution"
      "/assertions" "resolution"
      "/llm-prompts" "resolution"
      "/dossiers" "resolution"
      "/investigations" "resolution"
      "/screening" "screening" }}
{{- $httpEndpointRoutes := list }}
{{- range $path, $owner := $entityIntelligencePathOwners }}
{{-   $httpEndpointRoutes = append $httpEndpointRoutes (printf "%s%s=%s%s" $entityIntelligenceApiUrl $path (index $entityIntelligenceBaseUrls $owner) $path) }}
{{- end }}
platform:
  # quarkus | spring | micronaut. Every product (forwardmeasure-openworkflow, -entity-intelligence,
  # -data-streaming, -decision-engine) deploys each of its services in this framework: it picks the
  # image flavor, and the java-microservice chart derives probe paths and datasource env from it.
  # Service names never carry the framework, so no address anywhere changes when it does.
  framework: {{ $framework }}
  # kafka-streams | pekko-postgresql | pekko-cassandra. The one workflow engine
  # forwardmeasure-openworkflow deploys; execution-management admits every execution to it. Chosen
  # here at platform deploy time, like framework - a different engine is a different deployment.
  engine: {{ $engine }}
  namespaces:
    {{- toYaml $namespaces | nindent 4 }}
  gatewayApi:
    version: v1.5.1
  databases:
    # The platform control-plane database on the shared Postgres (Cloud SQL) instance: holds
    # tenant_registry (tenant -> tenant-database mapping) and Pekko's cluster-wide coordinator store.
    # Created by Terraform (openworkflow-k8s-setup on gcp-openworkflow-prod, k8s-infrastructure/
    # opentofu/gcp on a new cluster) or by the in-cluster Postgres locally; migrated by
    # forwardmeasure-openworkflow's migrations Jobs. Every product runtime reads tenant_registry from
    # it to route each request to that tenant's own database (forwardmeasure_<alias>, one schema per
    # product). Products never have a database of their own. The name shares the tenant databases'
    # forwardmeasure_ prefix, so forwardmeasure-jpa's TenantDatabase reserves the alias
    # "control_plane" - no tenant can ever be given this database.
    controlPlane: forwardmeasure_control_plane
    # Runtime roles created/rotated by forwardmeasure-openworkflow's migrations stage and used by
    # each product's servers - the name is a contract between that Job and the Secrets
    # platform-secrets delivers.
    runtimeRoles:
      decisionEngine: decision_engine
      entityIntelligence: entityintelligence
  identity:
    realm: {{ $keycloakRealm }}
    # The org-wide public client every product's organization/tenant-claim verification points at.
    organizationClientId: forwardmeasure-public
    # The platform's bootstrap administrator (the keycloak release creates it) - products grant it
    # their tenant roles.
    platformAdminUsername: platform-admin
    # The platform's own DID method (did:<didMethod>:...) - the only place it is named. Products
    # read it as FORWARDMEASURE_DID_METHOD (forwardmeasure-jpa's PlatformDids): workflow bundles are
    # did:<method>:bundle:<domain> and their documents DID URLs under that; resolved entities are
    # did:<method>:entity:<tenantId>:<uuid>.
    didMethod: fwm
  # Secrets forwardmeasure-platform's platform-secrets release delivers into product namespaces -
  # the name is the contract between this repository (producer) and the product (consumer).
  secrets:
    imagePull: docker-io-credentials
    # fowf's own bundle: OPENWORKFLOW_CLIENT_SECRET/OPENWORKFLOW_RUNTIME_DATABASE_PASSWORD/
    # OPENWORKFLOW_ADMIN_DATABASE_PASSWORD, synced into forwardmeasure-openworkflow's namespace.
    openworkflowIdentity: openworkflow-identity-credentials
    # Narrow, dedicated secrets carrying ONLY the Keycloak admin credential (KC_BOOTSTRAP_ADMIN_*),
    # synced into each product's own namespace for its own bootstrap Job to create/grant its own
    # Keycloak client(s) - deliberately NOT the openworkflowIdentity bundle, which those products
    # have no business ever holding.
    dataStreamingKeycloakAdmin: data-streaming-keycloak-admin
    entityIntelligenceKeycloakAdmin: entity-intelligence-keycloak-admin
    # Same OpenSearch username/password as the platform's own admin credential, delivered into
    # forwardmeasure-entity-intelligence's namespace (a secretKeyRef can't cross namespaces).
    entityIntelligenceOpenSearch: entity-intelligence-opensearch-credentials
    # entity-intelligence's server credentials: username/password of its runtime role plus
    # db-cloud-sql-instance for its services' Cloud SQL Auth Proxy sidecars. Deliberately separate
    # from entity-intelligence-credentials, which its own Keycloak bootstrap Job writes.
    entityIntelligenceDatabase: entity-intelligence-database-credentials
    # decision-engine's server credentials: username/password of its runtime role plus
    # db-cloud-sql-instance for its Cloud SQL Auth Proxy sidecar (one Secret, both consumers).
    decisionEngineDatabase: decision-engine-database-credentials
    # The shared Valkey's password (its single default ACL user), for decision-engine's fact window.
    decisionEngineValkey: decision-engine-valkey-auth
  endpoints:
    keycloak:
      host: {{ printf "%s.%s.svc.cluster.local" $keycloakService $namespaces.keycloak }}
      url: {{ $keycloakUrl }}
      realm: {{ $keycloakRealm }}
      issuer: {{ $issuer }}
      tokenUrl: {{ printf "%s/protocol/openid-connect/token" $issuer }}
    kafka:
      clusterName: {{ $kafkaClusterName }}
      bootstrapServers: {{ printf "%s-kafka-bootstrap.%s.svc.cluster.local:%d" $kafkaClusterName $namespaces.kafka $kafkaPort }}
    openSearch:
      # HTTPS - the cluster enables TLS on its HTTP layer (releases/opensearch-cluster).
      endpoint: {{ printf "https://%s.%s.svc.cluster.local:%d" $openSearchService $namespaces.openSearch $openSearchPort }}
    valkey:
      host: {{ printf "valkey.%s.svc.cluster.local" $namespaces.valkey }}
    # The platform's Apicurio Registry, in-cluster (its NetworkPolicy admits fowf's namespace).
    # Products publish the API documents their workflows reference here (the workflow bundle's
    # resources); fowf's definition-management fetches them at publication, so its resource
    # allowlist includes this host.
    registry:
      host: {{ printf "%s-app-service.%s.svc.cluster.local" $registryName $namespaces.registry }}
      apiUrl: {{ printf "http://%s-app-service.%s.svc.cluster.local:8080/apis/registry/v3" $registryName $namespaces.registry }}
    # fowf's own REST services - deployed by forwardmeasure-openworkflow, but every product calls them.
    openworkflow:
      # java-microservice Services listen on port 80 (targetPort 8080), hence no port.
      executionBaseUrl: {{ printf "http://openworkflow-execution-management.%s.svc.cluster.local" $namespaces.openworkflow }}
      definitionBaseUrl: {{ printf "http://openworkflow-definition-management.%s.svc.cluster.local" $namespaces.openworkflow }}
    # fei's REST services - deployed by forwardmeasure-entity-intelligence; apiUrl is the logical
    # address its OpenAPI document names, routed to these by httpEndpointRoutes below.
    entityIntelligence:
      apiUrl: {{ $entityIntelligenceApiUrl }}
      ingestionBaseUrl: {{ $entityIntelligenceBaseUrls.ingestion }}
      resolutionBaseUrl: {{ $entityIntelligenceBaseUrls.resolution }}
      screeningBaseUrl: {{ $entityIntelligenceBaseUrls.screening }}
  # logical=physical;... - where each product's logical API address (an OpenAPI document's
  # servers: URL) is served in-cluster, for fowf's operation adapter
  # (OPENWORKFLOW_ADAPTER_HTTP_ENDPOINT_ROUTES, HttpEndpointRoutes: longest prefix at a path
  # boundary wins). fei is routed per top-level path, to the service that implements it.
  httpEndpointRoutes: {{ join ";" $httpEndpointRoutes | quote }}
