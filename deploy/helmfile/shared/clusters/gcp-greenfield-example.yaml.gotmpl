# Worked example of a fresh GCP environment - see ../common.yaml.gotmpl's header.
{{- $domain := "new-platform.example" }}
{{- $loadBalancerIp := "203.0.113.10" }}
{{- $cloudProvider := "gcp" }}
{{- $gcpProjectId := "forwardmeasure-production" }}
{{- $gcpRegion := "us-central1" }}
{{- $gcpClusterName := "forwardmeasure-production" }}
{{- $cloudSqlInstance := "replace-with-keycloak-cloud-sql-instance" }}
# forwardmeasure-openworkflow's workload identities and overflow bucket - illustrative names:
# k8s-infrastructure/opentofu/gcp does NOT create these yet (it has no openworkflow service
# accounts or overflow bucket), so a real greenfield cluster must provision them first.
{{- $openworkflowRuntimeServiceAccount := "openworkflow-runtime@forwardmeasure-production.iam.gserviceaccount.com" }}
{{- $openworkflowMigrationsServiceAccount := "openworkflow-migrations@forwardmeasure-production.iam.gserviceaccount.com" }}
{{- $openworkflowOverflowBucket := "forwardmeasure-production-workflow-execution-overflow" }}
# decision-engine's workload identity - k8s-infrastructure/opentofu/gcp workload_service_accounts
# "decision-engine".
# entity-intelligence's workload identity - k8s-infrastructure/opentofu/gcp workload_service_accounts
# "entity-intelligence".
{{- $entityIntelligenceServiceAccount := "entity-intelligence@forwardmeasure-production.iam.gserviceaccount.com" }}
{{- $decisionEngineServiceAccount := "decision-engine@forwardmeasure-production.iam.gserviceaccount.com" }}
{{- $dataStreamingServiceAccount := "data-streaming@forwardmeasure-production.iam.gserviceaccount.com" }}
{{- $indexicalServiceAccount := "indexical@forwardmeasure-production.iam.gserviceaccount.com" }}
{{- $tenants := list (dict "alias" "example-bank" "displayName" "Example Bank") }}
platform:
  databases:
    # Shared physical-instance identity; never inferred from a service host, port or proxy.
    instanceIdentity: {{ printf "cloudsql:%s:%s:%s" $gcpProjectId $gcpRegion $cloudSqlInstance | quote }}
    admissionSlots: 1
    guardBuckets: 4096
  domain: {{ $domain | quote }}
  environment: production
  # Match Keycloak's advertised hostname exactly, including its configured :443.
  # Token/admin transport URLs remain internal in common.yaml.gotmpl.
  endpoints:
    keycloak:
      issuer: {{ printf "https://auth.%s:443/realms/forwardmeasure" $domain | quote }}
  gateway:
    loadBalancerIp: {{ $loadBalancerIp | quote }}
    hosts:
      root: {{ printf "platform.%s" $domain | quote }}
      tenant: {{ printf "*.%s" $domain | quote }}
      auth: {{ printf "auth.%s" $domain | quote }}
      registry: {{ printf "registry.%s" $domain | quote }}
      search: {{ printf "search.%s" $domain | quote }}
      analytics: {{ printf "analytics.%s" $domain | quote }}
      studio: {{ printf "studio.%s" $domain | quote }}
  # Tenants of this environment: alias and display name are the only inputs. host and did derive
  # from the alias and this environment's domain; the tenant's UUID is never stored anywhere - it is
  # always TenantId.forDid(did) (see forwardmeasure-openworkflow/docs/
  # tenant-provisioning-did-first-fix-2026-09-18.md).
  # Language-model profiles this environment offers (shared/common.yaml.gotmpl): url is the full
  # endpoint URL and wireFormat the API it speaks - openai-chat-completions (any OpenAI-compatible
  # chat/completions endpoint: a model provider, or a self-hosted server) or anthropic-messages
  # (Anthropic's Messages API, https://api.anthropic.com/v1/messages, whose structured outputs make
  # the reply schema-valid JSON). modelId is the model to request, and requestParameters the
  # model-specific settings merged into every request body (for example max_tokens; never a
  # temperature below 1 for Claude 4.7 and later, which rejects it). A profile's API key is the
  # platform credential platform-llm-<profile>-api-key (any value for a server without auth).
  llmProfiles:
    extraction:
      # Set both before deploying forwardmeasure-agent-ensemble: indexical-service refuses to
      # render without them.
      url: ""
      wireFormat: openai-chat-completions
      modelId: ""
      requestParameters: {}
  # The profile each product use runs on - one per deployment.
  llmProfileAssignments:
    # Indexical's extract step (forwardmeasure-agent-ensemble).
    indexicalExtraction: extraction
  tenants:
    {{- range $tenants }}
    {{- $host := printf "%s.%s" .alias $domain }}
    - alias: {{ .alias | quote }}
      displayName: {{ .displayName | quote }}
      host: {{ $host | quote }}
      did: {{ printf "did:web:%s" $host | quote }}
    {{- end }}
  cloud:
    provider: {{ $cloudProvider | quote }}
    {{- if eq $cloudProvider "gcp" }}
    gcp:
      projectId: {{ $gcpProjectId | quote }}
      region: {{ $gcpRegion | quote }}
      clusterName: {{ $gcpClusterName | quote }}
      cloudSql:
        instanceName: {{ $cloudSqlInstance | quote }}
        instanceConnectionName: {{ printf "%s:%s:%s" $gcpProjectId $gcpRegion $cloudSqlInstance | quote }}
      decisionEngine:
        serviceAccount: {{ $decisionEngineServiceAccount | quote }}
      dataStreaming:
        serviceAccount: {{ $dataStreamingServiceAccount | quote }}
      entityIntelligence:
        serviceAccount: {{ $entityIntelligenceServiceAccount | quote }}
        # Set from the entity-intelligence entry of the OpenTofu bucket_names output.
        evidenceBucket: "replace-with-entity-intelligence-bucket-output"
        # entity_intelligence_population_archive.bucket_name from the selected infrastructure stack.
        archiveBucket: "replace-with-population-archive-bucket-output"
        archiveKmsKey: {{ printf "projects/%s/locations/%s/keyRings/fei-archives-%s/cryptoKeys/population-archive" $gcpProjectId $gcpRegion (sha256sum $gcpClusterName | trunc 16) | quote }}
      indexical:
        serviceAccount: {{ $indexicalServiceAccount | quote }}
        # Set from the indexical entry of the OpenTofu bucket_names output.
        documentsBucket: "replace-with-indexical-documents-bucket-output"
      openworkflow:
        runtimeServiceAccount: {{ $openworkflowRuntimeServiceAccount | quote }}
        migrationsServiceAccount: {{ $openworkflowMigrationsServiceAccount | quote }}
        workflowExecutionOverflowBucket: {{ $openworkflowOverflowBucket | quote }}
    {{- end }}
