# kriyagentic.com / genai-llm-393115 / openworkflow-prod (GKE, us-central1) - the one real cluster
# forwardmeasure-platform, -openworkflow, -data-streaming, -entity-intelligence and -decision-engine
# all deploy into. See ../common.yaml.gotmpl's header.
{{- $domain := "kriyagentic.com" }}
{{- $loadBalancerIp := "34.71.159.15" }}
{{- $cloudProvider := "gcp" }}
{{- $gcpProjectId := "genai-llm-393115" }}
{{- $gcpRegion := "us-central1" }}
{{- $gcpClusterName := "openworkflow-prod" }}
# Shared Cloud SQL instance (keycloak/openworkflow/entity_intelligence/superset/platform databases).
{{- $cloudSqlInstance := "openworkflow-prod-postgres" }}
# forwardmeasure-openworkflow's workload identities and overflow bucket - created by
# openworkflow-k8s-setup/terraform/gcp (workload_identities "runtime"/"migrations",
# buckets.workflow_execution_overflow) for this cluster.
{{- $openworkflowRuntimeServiceAccount := "openworkflow-prod-runtime@genai-llm-393115.iam.gserviceaccount.com" }}
{{- $openworkflowMigrationsServiceAccount := "openworkflow-prod-migrations@genai-llm-393115.iam.gserviceaccount.com" }}
{{- $openworkflowOverflowBucket := "genai-llm-393115-openworkflow-prod-workflow-execution-overflow" }}
# decision-engine's workload identity - openworkflow-k8s-setup/terraform/gcp workload_identities
# "decision_engine" (account id truncated to 30 characters by that module).
# entity-intelligence's workload identity - openworkflow-k8s-setup/terraform/gcp workload_identities
# "entity_intelligence" (account id truncated to 30 characters by that module).
{{- $entityIntelligenceServiceAccount := "openworkflow-prod-entity-intel@genai-llm-393115.iam.gserviceaccount.com" }}
{{- $decisionEngineServiceAccount := "openworkflow-prod-decision-eng@genai-llm-393115.iam.gserviceaccount.com" }}
{{- $tenants := list (dict "alias" "lux" "displayName" "Lux Tenant") }}
platform:
  domain: {{ $domain | quote }}
  environment: production
  # Match Keycloak's advertised hostname exactly, including its configured :443.
  # Token/admin transport URLs remain internal in common.yaml.gotmpl.
  endpoints:
    keycloak:
      issuer: {{ printf "https://auth.%s:443/realms/forwardmeasure" $domain | quote }}
  gateway:
    loadBalancerIp: {{ $loadBalancerIp | quote }}
    hosts:
      root: {{ printf "platform.%s" $domain | quote }}
      tenant: {{ printf "*.%s" $domain | quote }}
      auth: {{ printf "auth.%s" $domain | quote }}
      registry: {{ printf "registry.%s" $domain | quote }}
      search: {{ printf "search.%s" $domain | quote }}
      analytics: {{ printf "analytics.%s" $domain | quote }}
      studio: {{ printf "studio.%s" $domain | quote }}
  # Tenants of this environment: alias and display name are the only inputs. host and did derive
  # from the alias and this environment's domain; the tenant's UUID is never stored anywhere - it is
  # always TenantId.forDid(did) (see forwardmeasure-openworkflow/docs/
  # tenant-provisioning-did-first-fix-2026-09-18.md).
  tenants:
    {{- range $tenants }}
    {{- $host := printf "%s.%s" .alias $domain }}
    - alias: {{ .alias | quote }}
      displayName: {{ .displayName | quote }}
      host: {{ $host | quote }}
      did: {{ printf "did:web:%s" $host | quote }}
    {{- end }}
  cloud:
    provider: {{ $cloudProvider | quote }}
    {{- if eq $cloudProvider "gcp" }}
    gcp:
      projectId: {{ $gcpProjectId | quote }}
      region: {{ $gcpRegion | quote }}
      clusterName: {{ $gcpClusterName | quote }}
      cloudSql:
        instanceName: {{ $cloudSqlInstance | quote }}
        instanceConnectionName: {{ printf "%s:%s:%s" $gcpProjectId $gcpRegion $cloudSqlInstance | quote }}
      decisionEngine:
        serviceAccount: {{ $decisionEngineServiceAccount | quote }}
      entityIntelligence:
        serviceAccount: {{ $entityIntelligenceServiceAccount | quote }}
        # Matches the dedicated bucket in openworkflow-k8s-setup/terraform/gcp/evidence-storage.tf.
        evidenceBucket: {{ printf "%s-fei-evidence-%s" $gcpProjectId (trunc 8 (sha256sum $gcpClusterName)) | quote }}
      openworkflow:
        runtimeServiceAccount: {{ $openworkflowRuntimeServiceAccount | quote }}
        migrationsServiceAccount: {{ $openworkflowMigrationsServiceAccount | quote }}
        workflowExecutionOverflowBucket: {{ $openworkflowOverflowBucket | quote }}
    {{- end }}
