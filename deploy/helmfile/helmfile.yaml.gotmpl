helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 1800
  atomic: true
  createNamespace: false

environments:
  base:
    values:
      - environments/chart-versions.yaml
      - environments/image-versions.yaml
      - environments/base.yaml.gotmpl
  # Cloud-wide GCP layer, no cluster tier - useful for confirming the gcp.yaml
  # layer alone renders correctly. Not used for a real install.
  gcp:
    values:
      - environments/chart-versions.yaml
      - environments/image-versions.yaml
      - environments/base.yaml.gotmpl
      - environments/gcp.yaml
  # Named gcp-openworkflow-prod (cloud-cluster), not just production, so
  # this matches exactly what forwardmeasure-openworkflow's own helmfile
  # registers - install-platform.sh passes one environment name to both
  # repos' installs. openworkflow's own persistence-profile choice
  # (postgresql vs cassandra for this cluster) lives inside that repo's own
  # gcp-openworkflow-prod.yaml.gotmpl as a plain value, not in this name.
  gcp-openworkflow-prod:
    values:
      - environments/chart-versions.yaml
      - environments/image-versions.yaml
      - environments/base.yaml.gotmpl
      - environments/gcp.yaml
      - environments/gcp-openworkflow-prod.yaml.gotmpl
  gcp-greenfield-example:
    values:
      - environments/chart-versions.yaml
      - environments/image-versions.yaml
      - environments/base.yaml.gotmpl
      - environments/gcp.yaml
      - environments/gcp-greenfield-example.yaml

---

{{- $layers := dict
  "base" (list "environments/chart-versions.yaml" "environments/image-versions.yaml" "environments/base.yaml.gotmpl")
  "gcp" (list "environments/chart-versions.yaml" "environments/image-versions.yaml" "environments/base.yaml.gotmpl" "environments/gcp.yaml")
  "gcp-openworkflow-prod" (list "environments/chart-versions.yaml" "environments/image-versions.yaml" "environments/base.yaml.gotmpl" "environments/gcp.yaml" "environments/gcp-openworkflow-prod.yaml.gotmpl")
  "gcp-greenfield-example" (list "environments/chart-versions.yaml" "environments/image-versions.yaml" "environments/base.yaml.gotmpl" "environments/gcp.yaml" "environments/gcp-greenfield-example.yaml")
}}
{{- $values := index $layers .Environment.Name | default (list) }}

helmfiles:
  - path: helmfiles/00-foundation.yaml.gotmpl
    values: {{ toYaml $values | nindent 6 }}
  - path: helmfiles/10-platform-configuration.yaml.gotmpl
    values: {{ toYaml $values | nindent 6 }}
  - path: helmfiles/20-identity.yaml.gotmpl
    values: {{ toYaml $values | nindent 6 }}
  - path: helmfiles/30-messaging.yaml.gotmpl
    values: {{ toYaml $values | nindent 6 }}
  - path: helmfiles/40-search.yaml.gotmpl
    values: {{ toYaml $values | nindent 6 }}
  - path: helmfiles/50-ml-serving.yaml.gotmpl
    values: {{ toYaml $values | nindent 6 }}
  - path: helmfiles/60-analytics.yaml.gotmpl
    values: {{ toYaml $values | nindent 6 }}
  - path: helmfiles/70-platform-dashboard.yaml.gotmpl
    values: {{ toYaml $values | nindent 6 }}
