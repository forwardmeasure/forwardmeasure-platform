repositories:
  - name: forwardmeasure
    url: https://forwardmeasure.github.io/helm-charts

releases:
  - name: decision-engine
    namespace: {{ .Values.namespaces.decisionEngine }}
    chart: forwardmeasure/decision-engine
    version: {{ .Values.chartVersions.decisionEngine | quote }}
    installed: {{ .Values.decisionEngine.enabled }}
    labels: {stage: decision-engine, component: server}
    values:
      - ../releases/decision-engine/base.yaml.gotmpl
