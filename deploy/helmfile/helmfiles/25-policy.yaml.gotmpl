repositories:
  - name: forwardmeasure
    url: https://forwardmeasure.github.io/helm-charts

releases:
  # Standalone policy-decision server (plain REST API), not the Kubernetes
  # admission-controller / Gatekeeper use case - no hard dependency on
  # identity (20-identity), just grouped next to it since both are
  # security-decision infrastructure. Currently the only caller is
  # forwardmeasure-agent-os's own agent-os-policy-{quarkus,spring,micronaut}
  # (see that repo's OpaPolicyEvaluator).
  - name: opa
    namespace: {{ .Values.namespaces.opa }}
    chart: forwardmeasure/opa
    version: {{ .Values.chartVersions.opa | quote }}
    labels: {stage: policy, component: opa}
    values:
      - ../releases/opa/base.yaml.gotmpl
