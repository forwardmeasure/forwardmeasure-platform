repositories:
  - name: forwardmeasure
    url: https://forwardmeasure.github.io/helm-charts

{{- $envParts := splitList "-" .Environment.Name }}
{{- $cloud := .Values | get "cloudProvider" "" }}

releases:
  - name: opensearch-cluster
    namespace: {{ .Values.namespaces.openSearch }}
    chart: {{ .Values.chartSources.openSearch.chart | quote }}
    {{ if eq .Values.chartSources.openSearch.mode "repository" }}
    version: {{ .Values.chartVersions.openSearch | quote }}
    {{ end }}
    # Needs a real ACME DNS-01 solver (gateway.clusterIssuer), same
    # reasoning as platform-certificates/platform-routing - not deployable
    # at the base tier.
    installed: {{ if $cloud }}true{{ else }}false{{ end }}
    labels: {stage: search, component: opensearch}
    {{- if $cloud }}
    values:
      - ../releases/opensearch.yaml.gotmpl
    {{- end }}
