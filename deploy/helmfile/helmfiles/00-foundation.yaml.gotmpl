repositories:
  - name: istio
    url: https://istio-release.storage.googleapis.com/charts
  - name: jetstack
    url: https://charts.jetstack.io
  - name: external-secrets
    url: https://charts.external-secrets.io

{{- $envParts := splitList "-" .Environment.Name }}
{{- $cloud := .Values | get "cloudProvider" "" }}

releases:
  - name: istio-base
    namespace: {{ .Values.namespaces.istio }}
    chart: istio/base
    version: {{ .Values.chartVersions.istio | quote }}
    labels: {stage: foundation, component: service-mesh}
    values:
      - ../releases/istio-base/base.yaml.gotmpl

  - name: istiod
    namespace: {{ .Values.namespaces.istio }}
    chart: istio/istiod
    version: {{ .Values.chartVersions.istio | quote }}
    needs: [{{ .Values.namespaces.istio }}/istio-base]
    labels: {stage: foundation, component: service-mesh}
    values:
      - ../releases/istiod/base.yaml.gotmpl

  - name: cert-manager
    namespace: {{ .Values.namespaces.certManager }}
    chart: jetstack/cert-manager
    version: {{ .Values.chartVersions.certManager | quote }}
    labels: {stage: foundation, component: certificates}
    values:
      - ../releases/cert-manager/base.yaml.gotmpl
    {{- if eq $cloud "gcp" }}
      - ../releases/cert-manager/gcp/base.yaml.gotmpl
    {{- end }}

  - name: external-secrets
    namespace: {{ .Values.namespaces.externalSecrets }}
    chart: external-secrets/external-secrets
    version: {{ .Values.chartVersions.externalSecrets | quote }}
    labels: {stage: foundation, component: secrets}
    values:
      - ../releases/external-secrets/base.yaml.gotmpl
    {{- if eq $cloud "gcp" }}
      - ../releases/external-secrets/gcp/base.yaml.gotmpl
    {{- end }}
