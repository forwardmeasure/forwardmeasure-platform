#
# The OpenSearch cluster's private root CA certificate, delivered into fei's namespace so its
# services and worker Jobs verify the https endpoint. The opensearch-cluster release publishes this
# key to the central store, so this ExternalSecret cannot live in platform-secrets (which installs
# before OpenSearch and waits for every secret it owns to be ready). It is the same chart, with no
# ClusterSecretStore of its own: the chart's default leaves clusterSecretStore disabled, and the one
# central store stays platform-secrets'.
secretStoreRef:
  name: {{ .Values.secretStore.name | quote }}
  kind: ClusterSecretStore
refreshInterval: {{ .Values.secretStore.refreshInterval | quote }}
secrets:
  - name: entity-intelligence-opensearch-ca
    enabled: true
    namespaces: [{{ .Values.namespaces.entityIntelligence }}]
    remoteRefs:
      - {secretKey: ca.crt, remoteKey: {{ .Values.secretStore.remoteKeys.openSearchRootCaCertificate | quote }} }
