image:
  repository: {{ .Values.imageVersions.platformDashboard.repository | quote }}
  tag: {{ .Values.imageVersions.platformDashboard.tag | quote }}
  digest: {{ .Values.imageVersions.platformDashboard.digest | quote }}
  pullPolicy: {{ .Values.imageVersions.platformDashboard.pullPolicy | quote }}
imagePolicy:
  requireDigest: true
imagePullSecrets: [docker-io-credentials]
replicaCount: {{ .Values.platformDashboard.replicas }}
autoscaling:
  enabled: true
  minReplicas: {{ .Values.platformDashboard.minReplicas }}
  maxReplicas: {{ .Values.platformDashboard.maxReplicas }}
resources: {{ toYaml .Values.platformDashboard.resources | nindent 2 }}
oidc:
  url: {{ printf "https://%s" .Values.gateway.authHost | quote }}
  issuer: {{ printf "https://%s/realms/%s" .Values.gateway.authHost .Values.identity.realm | quote }}
  realm: {{ .Values.identity.realm | quote }}
  clientId: {{ .Values.identity.publicClientId | quote }}
  audience: platform-dashboard-api
tenants:
  {{- range $tenant := .Values.tenants }}
  - host: {{ $tenant.host | quote }}
    did: {{ $tenant.did | quote }}
    name: {{ $tenant.code | quote }}
    displayName: {{ $tenant.name | quote }}
  {{- end }}
environment: {{ .Values.platform.environment | quote }}
applications:
  - id: openworkflow-studio
    name: OpenWorkflow Studio
    description: Author, publish, run and inspect durable Open Workflow definitions.
    href: /workflows/
  - id: entity-intelligence
    name: Entity Intelligence
    description: Ingest populations and evidence, screen, resolve entities and manage investigations.
    href: /ei/
probeTimeout: {{ .Values.platformDashboard.probeTimeout | quote }}
observationTtl: {{ .Values.platformDashboard.observationTtl | quote }}
route:
  enabled: true
  gatewayName: {{ .Values.gateway.name | quote }}
  gatewayNamespace: {{ .Values.namespaces.istio | quote }}
  listenerName: tenant-https
  hostname: {{ .Values.gateway.tenantHost | quote }}
components:
  - id: openworkflow-definition
    name: OpenWorkflow Definition API
    category: ORCHESTRATION
    probe: HTTP
    healthUri: {{ printf "http://openworkflow-definition-quarkus.%s.svc.cluster.local:8080/q/health/ready" .Values.namespaces.openworkflow | quote }}
    consoleUri: /workflows/
  - id: openworkflow-kafka
    name: OpenWorkflow Kafka Engine
    category: ORCHESTRATION
    probe: HTTP
    healthUri: {{ printf "http://openworkflow-kafka.%s.svc.cluster.local:8080/q/health/ready" .Values.namespaces.openworkflow | quote }}
  - id: openworkflow-pekko
    name: OpenWorkflow Pekko Engine
    category: ORCHESTRATION
    probe: HTTP
    healthUri: {{ printf "http://openworkflow-pekko-postgresql.%s.svc.cluster.local:8080/q/health/ready" .Values.namespaces.openworkflow | quote }}
  - id: keycloak
    name: Identity And Access Management
    category: IDENTITY
    probe: HTTP
    healthUri: {{ printf "http://keycloak.%s.svc.cluster.local:8080/realms/%s" .Values.namespaces.keycloak .Values.identity.realm | quote }}
    consoleUri: {{ printf "https://%s/admin/%s/console/" .Values.gateway.authHost .Values.identity.realm | quote }}
  - id: kafka
    name: Apache Kafka
    category: MESSAGING
    probe: TCP
    healthUri: {{ printf "tcp://%s" .Values.kafka.bootstrapServers | quote }}
  - id: apicurio-registry
    name: Apicurio Registry
    category: SCHEMA_GOVERNANCE
    probe: HTTP
    healthUri: {{ printf "http://%s-app-service.%s.svc.cluster.local:8080/apis/registry/v3/system/info" .Values.registry.name .Values.namespaces.registry | quote }}
    consoleUri: {{ printf "https://%s/" .Values.gateway.registryHost | quote }}
  - id: opensearch
    name: OpenSearch
    category: SEARCH
    probe: TCP
    healthUri: {{ printf "tcp://opensearch-cluster-master.%s.svc.cluster.local:9200" .Values.namespaces.openSearch | quote }}
    consoleUri: {{ printf "https://%s/" .Values.gateway.searchHost | quote }}
  - id: superset
    name: Apache Superset
    category: ANALYTICS
    probe: HTTP
    healthUri: {{ printf "http://superset.%s.svc.cluster.local:8088/health" .Values.namespaces.superset | quote }}
    consoleUri: {{ printf "https://%s/" .Values.gateway.analyticsHost | quote }}
  - id: named-entity-recognition
    name: Named Entity Recognition
    category: MODEL_SERVING
    probe: TCP
    healthUri: {{ printf "tcp://ner-gliner-medium-v2-1-predictor.%s.svc.cluster.local:80" .Values.namespaces.modelServing | quote }}
