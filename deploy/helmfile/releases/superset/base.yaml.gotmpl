#
# docker.io/forwardmeasure/superset (not the stock apache/superset image)
# bakes in psycopg2-binary at build time - see
# data-fabric-devops-utils/docker-images/superset's Dockerfile/
# requirements.txt, the same image data-fabric's own platform-helmlines-setup
# already uses. The stock image ships driver-agnostic - no Postgres DBAPI at
# all, despite SQLALCHEMY_DATABASE_URI (below) being a plain postgresql://
# URI - confirmed the hard way running against it directly: every one of
# supersetNode/supersetWorker/init crashed identically on
# ModuleNotFoundError: No module named 'psycopg2' the moment it actually
# reached the database. A bootstrapScript pip-install-at-startup patch
# worked too but re-runs on every pod start/restart; baked into the image
# is the real fix, matching how this problem is already solved elsewhere in
# the ecosystem.
image:
  repository: {{ .Values.imageVersions.superset.repository | quote }}
  tag: {{ .Values.imageVersions.superset.tag | quote }}
  pullPolicy: {{ .Values.imageVersions.superset.pullPolicy | quote }}

secretEnv: {create: false}
envFromSecret: superset-env
redis: {enabled: false}
postgresql: {enabled: false}
serviceAccount: {create: true}
imagePullSecrets: [{name: docker-io-credentials}]
supersetNode:
  replicas: {enabled: true, replicaCount: {{ .Values.analytics.supersetReplicas }}}
  podDisruptionBudget: {enabled: true, minAvailable: null, maxUnavailable: 1}
supersetWorker:
  replicas: {enabled: true, replicaCount: {{ .Values.analytics.supersetWorkers }}}
  podDisruptionBudget: {enabled: true, minAvailable: null, maxUnavailable: 1}
extraEnv:
  REDIS_HOST: {{ printf "valkey.%s.svc.cluster.local" .Values.namespaces.valkey | quote }}
  REDIS_PORT: "6379"
  REDIS_USER: default
  REDIS_PROTO: redis
  REDIS_DB: "1"
  REDIS_CELERY_DB: "0"
  OIDC_CLIENT_ID: superset
  OIDC_ISSUER: {{ printf "https://%s/realms/%s" .Values.gateway.authHost .Values.identity.realm | quote }}
configOverrides:
  database: |
    import os
    SQLALCHEMY_DATABASE_URI = os.environ["SQLALCHEMY_DATABASE_URI"]
  oidc: |
    import os
    from flask_appbuilder.security.manager import AUTH_OAUTH
    AUTH_TYPE = AUTH_OAUTH
    AUTH_USER_REGISTRATION = True
    AUTH_USER_REGISTRATION_ROLE = "Gamma"
    OAUTH_PROVIDERS = [{
      "name": "keycloak",
      "token_key": "access_token",
      "icon": "fa-key",
      "remote_app": {
        "client_id": os.environ["OIDC_CLIENT_ID"],
        "client_secret": os.environ["OIDC_CLIENT_SECRET"],
        "api_base_url": os.environ["OIDC_ISSUER"] + "/protocol/openid-connect/",
        "access_token_url": os.environ["OIDC_ISSUER"] + "/protocol/openid-connect/token",
        "authorize_url": os.environ["OIDC_ISSUER"] + "/protocol/openid-connect/auth",
        "client_kwargs": {"scope": "openid email profile"},
        "server_metadata_url": os.environ["OIDC_ISSUER"] + "/.well-known/openid-configuration"
      }
    }]
init:
  enabled: true
  createAdmin: false
  # Logging/error-handling style matches data-fabric's own proven
  # platform-helmlines-setup/releases/superset/base.yaml.gotmpl - admin
  # creation itself still uses explicit --username/--email/--password flags
  # sourced from ADMIN_USERNAME/ADMIN_EMAIL/ADMIN_PASSWORD (createAdmin:
  # false above disables this chart's own native flag-driven admin
  # creation), not data-fabric's "$@" positional-args form - this
  # deployment's init Job doesn't pass those, so copying that form verbatim
  # would silently create an admin with empty credentials.
  initscript: |-
    #!/bin/sh
    set -eu
    echo "Running DB migrations..."
    superset db upgrade
    echo "Initializing roles..."
    superset init
    echo "Creating admin (ignore if exists)..."
    set +e
    superset fab create-admin \
      --username "${ADMIN_USERNAME}" \
      --firstname Platform \
      --lastname Administrator \
      --email "${ADMIN_EMAIL}" \
      --password "${ADMIN_PASSWORD}"
    rc=$?
    set -e
    if [ "$rc" -ne 0 ]; then
      echo "create-admin returned non-zero ($rc). Continuing."
    fi
    echo "Init job completed successfully."
