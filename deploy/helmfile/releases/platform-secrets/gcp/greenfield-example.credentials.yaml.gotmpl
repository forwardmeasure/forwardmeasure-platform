#
# Fake ClusterSecretStore provider data for the gcp-greenfield-example
# environment - unlike the real openworkflow-prod cluster's equivalent file
# (gitignored, one real value), every value here is a non-functional
# CHANGE-ME placeholder, safe to commit. Copy this alongside
# environments/gcp-greenfield-example.yaml when standing up a real new
# cluster, matching its own naming ({cloud}/{cluster}.credentials.yaml.gotmpl).
clusterSecretStore:
  enabled: true
  name: fake-secret-store
  provider:
    fake:
      data:
        # auth must decode to a real base64(username:password) shape - a
        # colon-free placeholder here is structurally invalid and kubelet
        # hard-rejects any pod using it as an imagePullSecret with "unable
        # to parse auth field, must be formatted as base64(username:password)"
        # (confirmed the hard way against the real openworkflow-prod
        # cluster's equivalent file, which had this same value).
        - key: platform-container-registry-dockerconfigjson
          value: '{"auths":{"https://index.docker.io/v1/":{"auth":"Y2hhbmdlbWU6Y2hhbmdlbWU="}}}'

        - key: platform-keycloak-database-username
          value: "CHANGE-ME-dev-placeholder"
        - key: platform-keycloak-database-password
          value: "CHANGE-ME-dev-placeholder"
        - key: platform-keycloak-database-url
          value: "jdbc:postgresql://localhost:5432/keycloak"

        - key: platform-keycloak-admin-username
          value: "CHANGE-ME-dev-placeholder"
        - key: platform-keycloak-admin-password
          value: "CHANGE-ME-dev-placeholder"
        - key: platform-keycloak-bootstrap-password
          value: "CHANGE-ME-dev-placeholder"
        - key: platform-keycloak-confidential-client-secret
          value: "CHANGE-ME-dev-placeholder"

        - key: platform-opensearch-admin-username
          value: "CHANGE-ME-dev-placeholder"
        - key: platform-opensearch-admin-password
          value: "CHANGE-ME-dev-placeholder"
        - key: platform-opensearch-admin-password-hash
          value: "CHANGE-ME-dev-placeholder-not-a-real-bcrypt-hash"
        - key: platform-opensearch-admin-cookie
          value: "CHANGE-ME-dev-placeholder"

        - key: platform-huggingface-token
          value: "CHANGE-ME-dev-placeholder"

        - key: platform-superset-secret-key
          value: "CHANGE-ME-dev-placeholder"
        - key: platform-superset-database-uri
          value: "postgresql://superset:CHANGE-ME-dev-placeholder@localhost:5432/superset"
        - key: platform-superset-database-host
          value: "localhost"
        - key: platform-superset-database-port
          value: "5432"
        - key: platform-superset-database-name
          value: "superset"
        - key: platform-superset-database-username
          value: "CHANGE-ME-dev-placeholder"
        - key: platform-superset-database-password
          value: "CHANGE-ME-dev-placeholder"
        - key: platform-superset-admin-username
          value: "CHANGE-ME-dev-placeholder"
        - key: platform-superset-admin-password
          value: "CHANGE-ME-dev-placeholder"
        - key: platform-superset-admin-email
          value: "platform-owner@new-platform.example"

        - key: platform-valkey-password
          value: "CHANGE-ME-dev-placeholder"

        - key: platform-openworkflow-database-password
          value: "CHANGE-ME-dev-placeholder"
