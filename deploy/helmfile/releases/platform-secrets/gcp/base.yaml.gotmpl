#
# clusterSecretStore is deliberately not set here - the chart's own default
# (enabled: false, name: fake-secret-store) is exactly the "fake for now,
# real later" pattern this platform already uses elsewhere (see
# data-fabric's platform-secrets/gcp usage of this same chart). Whoever
# migrates to a real backend adds a clusterSecretStore override (provider,
# enabled: true) in that environment's own values layer - not here, so
# every other environment isn't forced onto the same backend.
secretStoreRef:
  name: {{ .Values.secretStore.name | quote }}
  kind: ClusterSecretStore
refreshInterval: {{ .Values.secretStore.refreshInterval | quote }}
secrets:
  - name: docker-io-credentials
    enabled: true
    secretType: kubernetes.io/dockerconfigjson
    namespaces:
      - {{ .Values.namespaces.platform }}
      - {{ .Values.namespaces.openworkflow }}
      - {{ .Values.namespaces.keycloak }}
      - {{ .Values.namespaces.registry }}
      - {{ .Values.namespaces.openSearch }}
      - {{ .Values.namespaces.modelServing }}
      - {{ .Values.namespaces.docling }}
      - {{ .Values.namespaces.superset }}
      # forwardmeasure-data-streaming's own launcher (2026-09-26) - pulls its 3 private
      # docker.io/forwardmeasure/data-streaming-* executor images, same registry/credential as
      # every other consumer of this secret.
      - {{ .Values.namespaces.dataStreaming }}
      # forwardmeasure-entity-intelligence's and forwardmeasure-decision-engine's private
      # docker.io/forwardmeasure/* images.
      - {{ .Values.namespaces.entityIntelligence }}
      {{- if .Values.platform.products.decisionEngine.enabled }}
      - {{ .Values.namespaces.decisionEngine }}
      {{- end }}
    remoteRefs:
      - secretKey: .dockerconfigjson
        remoteKey: {{ .Values.secretStore.remoteKeys.dockerConfig | quote }}
  # forwardmeasure-data-streaming's own launcher (2026-09-26) - mirrors entityIntelligence's own
  # "genuinely optional until a real Terraform/Secret-Manager entry exists" precedent immediately
  # below (dig with an empty default plus an if-guard, not a bare .Values dot-access) - the real
  # remote keys don't exist yet; this is additive/inert until they do, and does not error this
  # release for any environment that never sets them.
  - name: data-streaming-launcher-credentials
    enabled: true
    namespaces: [{{ .Values.namespaces.dataStreaming }}]
    remoteRefs:
      {{- if (dig "secretStore" "remoteKeys" "dataStreamingAuthorizationClientSecret" "" .Values) }}
      - {secretKey: authorization-client-secret, remoteKey: {{ dig "secretStore" "remoteKeys" "dataStreamingAuthorizationClientSecret" "" .Values | quote }} }
      {{- end }}
      {{- if (dig "secretStore" "remoteKeys" "dataStreamingFowfKeycloakClientId" "" .Values) }}
      - {secretKey: fowf-keycloak-client-id, remoteKey: {{ dig "secretStore" "remoteKeys" "dataStreamingFowfKeycloakClientId" "" .Values | quote }} }
      {{- end }}
      {{- if (dig "secretStore" "remoteKeys" "dataStreamingFowfKeycloakClientSecret" "" .Values) }}
      - {secretKey: fowf-keycloak-client-secret, remoteKey: {{ dig "secretStore" "remoteKeys" "dataStreamingFowfKeycloakClientSecret" "" .Values | quote }} }
      {{- end }}
  - name: {{ .Values.identity.databaseSecret }}
    enabled: true
    namespaces: [{{ .Values.namespaces.keycloak }}]
    remoteRefs:
      - {secretKey: KC_DB_USERNAME, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakDatabaseUsername | quote }}}
      - {secretKey: KC_DB_PASSWORD, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakDatabasePassword | quote }}}
      - {secretKey: KC_DB_URL, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakDatabaseUrl | quote }}}
  - name: {{ .Values.identity.adminSecret }}
    enabled: true
    namespaces: [{{ .Values.namespaces.keycloak }}]
    remoteRefs:
      - {secretKey: KEYCLOAK_ADMIN, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakAdminUsername | quote }}}
      - {secretKey: KEYCLOAK_ADMIN_PASSWORD, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakAdminPassword | quote }}}
  - name: {{ .Values.identity.bootstrapSecret }}
    enabled: true
    namespaces: [{{ .Values.namespaces.keycloak }}]
    remoteRefs:
      - {secretKey: password, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakBootstrapPassword | quote }}}
  - name: {{ .Values.identity.clientSecret }}
    enabled: true
    namespaces: [{{ .Values.namespaces.keycloak }}]
    remoteRefs:
      - {secretKey: FORWARDMEASURE_ADMIN_CONFIDENTIAL_CLIENT_SECRET, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakConfidentialClientSecret | quote }}}
      {{- range $index, $client := .Values.identity.serviceClients }}
      - secretKey: {{ required (printf "identity.serviceClients[%d].secretKey is required" $index) $client.secretKey | quote }}
        remoteKey: {{ required (printf "identity.serviceClients[%d].secretRemoteKey is required" $index) $client.secretRemoteKey | quote }}
      {{- end }}
  # Narrow companion below (identity.dataStreamingCredentialsSecret), carrying only the Keycloak
  # admin credential - forwardmeasure-data-streaming's own launcher-credentials bootstrap Job
  # (deploy/helmfile/helmfiles/credentials.yaml.gotmpl in that repo) needs it to create/grant its
  # own "datastreaming" Keycloak client, exactly as openworkflow-platform-clients already does for
  # openworkflow-entity-intelligence-workflow-{author,publisher}. It deliberately does NOT get the
  # rest of this Secret's own bundle (OPENWORKFLOW_CLIENT_SECRET/database passwords below), which
  # belongs to fowf alone - see that entry's own comment.
  - name: {{ .Values.identity.dataStreamingCredentialsSecret }}
    enabled: true
    namespaces: [{{ .Values.namespaces.dataStreaming }}]
    remoteRefs:
      - {secretKey: KC_BOOTSTRAP_ADMIN_USERNAME, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakAdminUsername | quote }} }
      - {secretKey: KC_BOOTSTRAP_ADMIN_PASSWORD, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakAdminPassword | quote }} }
  # Mirrors identity.dataStreamingCredentialsSecret immediately above exactly, same reasoning, for
  # forwardmeasure-entity-intelligence's own bootstrap Job (2026-09-29) - see identity.
  # entityIntelligenceCredentialsSecret's own comment in environments/base.yaml.gotmpl.
  - name: {{ .Values.identity.entityIntelligenceCredentialsSecret }}
    enabled: true
    namespaces: [{{ .Values.namespaces.entityIntelligence }}]
    remoteRefs:
      - {secretKey: KC_BOOTSTRAP_ADMIN_USERNAME, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakAdminUsername | quote }} }
      - {secretKey: KC_BOOTSTRAP_ADMIN_PASSWORD, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakAdminPassword | quote }} }
  # OpenSearch credentials for forwardmeasure-entity-intelligence (2026-09-29) - the same remote keys
  # the opensearch-cluster release's own admin Secret uses, delivered into fei's namespace so its REST
  # services and dispatched worker Jobs can authenticate to the platform's secured OpenSearch. Its own
  # Secret, not a key in fei's entity-intelligence-credentials: that one is owned and patched by fei's
  # own bootstrap Job, and an ExternalSecret targeting it would fight that Job over the same object.
  - name: {{ .Values.openSearch.entityIntelligenceCredentialsSecret }}
    enabled: true
    namespaces: [{{ .Values.namespaces.entityIntelligence }}]
    remoteRefs:
      - {secretKey: username, remoteKey: {{ .Values.secretStore.remoteKeys.openSearchUsername | quote }} }
      - {secretKey: password, remoteKey: {{ .Values.secretStore.remoteKeys.openSearchPassword | quote }} }
  - name: {{ .Values.identity.openworkflowCredentialsSecret }}
    enabled: true
    namespaces: [{{ .Values.namespaces.openworkflow }}]
    remoteRefs:
      - {secretKey: KC_BOOTSTRAP_ADMIN_USERNAME, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakAdminUsername | quote }} }
      - {secretKey: KC_BOOTSTRAP_ADMIN_PASSWORD, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakAdminPassword | quote }} }
      # Was wrongly sourced from keycloakConfidentialClientSecret (Superset's
      # own confidential-client secret) - fixed to OpenWorkflow's own
      # dedicated service client (identity.serviceClients, clientId:
      # openworkflow) and its own remote key.
      - {secretKey: OPENWORKFLOW_CLIENT_SECRET, remoteKey: {{ .Values.secretStore.remoteKeys.openworkflowClientSecret | quote }} }
      # Runtime credential (role: openworkflow) - used by application
      # services and by the migrations Job to create runtime-scoped tenant
      # schema objects. Never used to connect as admin.
      - {secretKey: OPENWORKFLOW_RUNTIME_DATABASE_PASSWORD, remoteKey: {{ .Values.secretStore.remoteKeys.openworkflowRuntimeDatabasePassword | quote }} }
      # Administrator credential (role: forwardmeasure_admin) - used only
      # by the migrations Job to create/rotate the runtime role, run schema
      # DDL, and grant runtime privileges. See
      # openworkflow-k8s-setup/docs/operations.md's "Database role
      # provisioning" section. Never granted to a runtime workload.
      - {secretKey: OPENWORKFLOW_ADMIN_DATABASE_PASSWORD, remoteKey: {{ .Values.secretStore.remoteKeys.openworkflowAdministratorDatabasePassword | quote }} }
      # Keycloak's and Superset's database roles are created by Terraform (cloudsql_users), not
      # by the migrations Job, so their passwords are not delivered here.
      # fei's own runtime role (entityintelligence) - fei and fowf share each tenant database, and
      # entity-intelligence-migrations runs as the same migrations workload identity, so its
      # runtime password is delivered here too.
      # entity-intelligence-migrations' own release (deploy/helmfile/releases/entity-intelligence-migrations)
      # reads this same openworkflow-identity-credentials Secret via its own credentialsSecretName
      # override. No base default for the remote key, matching
      # openworkflowRuntimeDatabasePassword's own precedent immediately above - its real Secret
      # Manager name is environment/Terraform-specific and not provisioned yet; add
      # secretStore.remoteKeys.entityIntelligenceRuntimeDatabasePassword to the relevant
      # environment file (e.g. gcp-openworkflow-prod.yaml.gotmpl) once a real Terraform entry
      # exists for it. Genuinely optional until then - a bare `.Values...` dot-access here (as
      # this line originally had) errors the ENTIRE platform-secrets release for every GCP
      # environment the moment the key is unset anywhere, not just fei's own remoteRef entry
      # (confirmed 2026-09-16: broke gcp, gcp-openworkflow-prod, and gcp-greenfield-example alike,
      # since none had provisioned it yet) - same missing-key-strictness class of bug as
      # .Values.tenants elsewhere in this repo pair. `dig` with a default makes the omission
      # actually optional, matching what the comment already promised.
      {{- if (dig "secretStore" "remoteKeys" "entityIntelligenceRuntimeDatabasePassword" "" .Values) }}
      - {secretKey: ENTITY_INTELLIGENCE_RUNTIME_DATABASE_PASSWORD, remoteKey: {{ dig "secretStore" "remoteKeys" "entityIntelligenceRuntimeDatabasePassword" "" .Values | quote }} }
      {{- end }}
      # decision-engine's own runtime role (decision_engine) - same reasoning as fei's immediately
      # above: forwardmeasure-openworkflow's decision-engine-migrations release (same shared tenant
      # databases, same admin workload identity) reads DECISION_ENGINE_RUNTIME_DATABASE_PASSWORD from
      # this Secret, creates/rotates the role with it, and grants it tenant_registry read. Without this
      # key that Job's pod cannot start (non-optional secretKeyRef).
      {{- if and .Values.platform.products.decisionEngine.enabled (dig "secretStore" "remoteKeys" "decisionEngineRuntimeDatabasePassword" "" .Values) }}
      - {secretKey: DECISION_ENGINE_RUNTIME_DATABASE_PASSWORD, remoteKey: {{ dig "secretStore" "remoteKeys" "decisionEngineRuntimeDatabasePassword" "" .Values | quote }} }
      {{- end }}
  - name: huggingface-token
    enabled: true
    namespaces: [{{ .Values.namespaces.modelServing }}, {{ .Values.namespaces.docling }}]
    remoteRefs:
      - {secretKey: token, remoteKey: {{ .Values.secretStore.remoteKeys.huggingFaceToken | quote }}}
  - name: superset-env
    enabled: true
    namespaces: [{{ .Values.namespaces.superset }}]
    remoteRefs:
      - {secretKey: SUPERSET_SECRET_KEY, remoteKey: {{ .Values.secretStore.remoteKeys.supersetSecretKey | quote }}}
      - {secretKey: SQLALCHEMY_DATABASE_URI, remoteKey: {{ .Values.secretStore.remoteKeys.supersetDatabaseUri | quote }}}
      - {secretKey: DB_HOST, remoteKey: {{ .Values.secretStore.remoteKeys.supersetDatabaseHost | quote }}}
      - {secretKey: DB_PORT, remoteKey: {{ .Values.secretStore.remoteKeys.supersetDatabasePort | quote }}}
      - {secretKey: DB_NAME, remoteKey: {{ .Values.secretStore.remoteKeys.supersetDatabaseName | quote }}}
      - {secretKey: DB_USER, remoteKey: {{ .Values.secretStore.remoteKeys.supersetDatabaseUsername | quote }}}
      - {secretKey: DB_PASS, remoteKey: {{ .Values.secretStore.remoteKeys.supersetDatabasePassword | quote }}}
      - {secretKey: ADMIN_USERNAME, remoteKey: {{ .Values.secretStore.remoteKeys.supersetAdminUsername | quote }}}
      - {secretKey: ADMIN_PASSWORD, remoteKey: {{ .Values.secretStore.remoteKeys.supersetAdminPassword | quote }}}
      - {secretKey: ADMIN_EMAIL, remoteKey: {{ .Values.secretStore.remoteKeys.supersetAdminEmail | quote }}}
      - {secretKey: OIDC_CLIENT_SECRET, remoteKey: {{ .Values.secretStore.remoteKeys.keycloakConfidentialClientSecret | quote }}}
      - {secretKey: REDIS_PASSWORD, remoteKey: {{ .Values.secretStore.remoteKeys.valkeyPassword | quote }}}
  - name: valkey-auth
    enabled: true
    namespaces: [{{ .Values.namespaces.valkey }}]
    remoteRefs:
      - {secretKey: password, remoteKey: {{ .Values.secretStore.remoteKeys.valkeyPassword | quote }}}
  # decision-engine's fact window uses the shared Valkey as its default ACL user - same password
  # superset's REDIS_PASSWORD carries, delivered into decision-engine's own namespace.
  {{- if .Values.platform.products.decisionEngine.enabled }}
  - name: {{ .Values.platform.secrets.decisionEngineValkey }}
    enabled: true
    namespaces: [{{ .Values.namespaces.decisionEngine }}]
    remoteRefs:
      - {secretKey: password, remoteKey: {{ .Values.secretStore.remoteKeys.valkeyPassword | quote }}}
  {{- end }}
  # entity-intelligence's server credentials, in its own namespace - same shape as decision-engine's
  # below: the entityintelligence runtime role (created by forwardmeasure-openworkflow's
  # entity-intelligence-migrations Job from the same remote key delivered into
  # openworkflowCredentialsSecret above) plus db-cloud-sql-instance for every service's Cloud SQL
  # Auth Proxy sidecar (java-microservice-helm-chart cloudSqlProxy.existingSecretName).
  {{- if (dig "secretStore" "remoteKeys" "entityIntelligenceRuntimeDatabasePassword" "" .Values) }}
  - name: {{ .Values.platform.secrets.entityIntelligenceDatabase }}
    enabled: true
    namespaces: [{{ .Values.namespaces.entityIntelligence }}]
    templateData:
      username: {{ .Values.platform.databases.runtimeRoles.entityIntelligence | quote }}
      password: '{{ "{{ .password }}" }}'
      {{- with (dig "platform" "cloud" "gcp" "cloudSql" "instanceConnectionName" "" .Values) }}
      db-cloud-sql-instance: {{ . | quote }}
      {{- end }}
    remoteRefs:
      - {secretKey: password, remoteKey: {{ dig "secretStore" "remoteKeys" "entityIntelligenceRuntimeDatabasePassword" "" .Values | quote }} }
  {{- end }}
  # decision-engine's server credentials, in its own namespace: the decision_engine runtime role
  # (created by forwardmeasure-openworkflow's decision-engine-migrations Job from the same remote
  # key delivered into openworkflowCredentialsSecret above) plus db-cloud-sql-instance for the
  # chart's Cloud SQL Auth Proxy sidecar (cloudSqlProxy.existingSecretName). The username and the
  # instance connection name are not secret - they come from the shared layer, composed in by
  # External Secrets' template ({{ "{{ .password }}" }} is evaluated by the operator, not Helm).
  {{- if and .Values.platform.products.decisionEngine.enabled (dig "secretStore" "remoteKeys" "decisionEngineRuntimeDatabasePassword" "" .Values) }}
  - name: {{ .Values.platform.secrets.decisionEngineDatabase }}
    enabled: true
    namespaces: [{{ .Values.namespaces.decisionEngine }}]
    templateData:
      username: {{ .Values.platform.databases.runtimeRoles.decisionEngine | quote }}
      password: '{{ "{{ .password }}" }}'
      {{- with (dig "platform" "cloud" "gcp" "cloudSql" "instanceConnectionName" "" .Values) }}
      db-cloud-sql-instance: {{ . | quote }}
      {{- end }}
    remoteRefs:
      - {secretKey: password, remoteKey: {{ dig "secretStore" "remoteKeys" "decisionEngineRuntimeDatabasePassword" "" .Values | quote }} }
  {{- end }}
  # Per-tenant workflow-call secrets (call:http/call:openapi/call:grpc/call:asyncapi/etc.
  # `authentication:` blocks) - consumed by forwardmeasure-openworkflow's DirectorySecretProvider via
  # a per-tenant Secret volume mount (see openworkflow-service's extraVolumes/extraVolumeMounts,
  # wired per-tenant in operation-adapters.yaml.gotmpl). Deliberately empty/absent per tenant until a
  # real workflow-call secret is actually needed - same "no plausible default" precedent as
  # entityIntelligenceRuntimeDatabasePassword above: this only ever emits an ExternalSecret for a
  # tenant that has a non-empty .workflowSecrets list declared against it in the environment file's
  # own tenants: block (e.g. add `workflowSecrets: [{secretKey: MY_KEY, remoteKey: <secret-manager-key>}]`
  # to that tenant's entry in gcp-openworkflow-prod.yaml.gotmpl once a real integration needs one).
  # Until then this range produces nothing, matching today's reality: no tenant has any workflow-call
  # secret provisioned yet, and this platform's secretStore is itself still the fake-secret-store
  # default (see this file's own header comment) - flipping that on is a separate, later step.
  {{- range $.Values.tenants }}
  {{- $workflowSecrets := index . "workflowSecrets" }}
  {{- if $workflowSecrets }}
  # Keyed on .code (this repo's own name for the alias concept forwardmeasure-openworkflow calls
  # .alias), not a UUID - fixed 2026-09-29, see forwardmeasure-openworkflow/docs/tenant-identity-
  # platform-vs-fowf-handover-2026-09-29.md. This used to key on .id (a literal, hand-picked UUID
  # that never existed on the fowf side), which fowf's own operation-adapters.yaml.gotmpl could
  # never actually mount (it derives the same Secret name from .alias) - a real, confirmed, latent
  # cross-repo naming mismatch, dormant only because no tenant has declared workflowSecrets yet.
  - name: {{ printf "openworkflow-tenant-%s-workflow-secrets" .code | quote }}
    enabled: true
    namespaces: [{{ $.Values.namespaces.openworkflow }}]
    remoteRefs:
      {{- range $workflowSecrets }}
      - {secretKey: {{ .secretKey | quote }}, remoteKey: {{ .remoteKey | quote }}}
      {{- end }}
  {{- end }}
  {{- end }}
