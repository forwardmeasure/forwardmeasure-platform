# kriyagentic.com / genai-llm-393115 / openworkflow-prod (GKE, us-central1).
# gcp.*ServiceAccountEmail and gcp.modelCacheBucket below match what
# openworkflow-k8s-setup's terraform/gcp actually created - see its
# workload_identities "dns"/"eso"/"model-svc" entries and the model_cache
# bucket in terraform.tfvars. secretStore is deliberately left at base's
# fake-secret-store default rather than overridden here - see
# platform-secrets.yaml.gotmpl and its openworkflow-prod credentials layer.
# Domain, gateway IP/hostnames, gcp.projectId/region/clusterName and the Cloud SQL instance come
# from ../shared/clusters/gcp-openworkflow-prod.yaml.gotmpl (via shared-aliases.yaml.gotmpl) - the
# same file every product repository reads. So do tenants[] and bootstrapIdentity (the lux tenant's
# alias, display name, host and DID); $tenantDid is read from it for the service client below.
# {{- $tenantDid := (index (tpl (readFile "../shared/clusters/gcp-openworkflow-prod.yaml.gotmpl") (dict) | fromYaml).platform.tenants 0).did }}
# Corrected 2026-09-29 (see forwardmeasure-openworkflow/docs/tenant-identity-platform-vs-fowf-
# handover-2026-09-29.md for the full investigation): this used to also hardcode a literal
# $tenantId ("c0d34a2f-387e-4c89-9b84-75c5bbff9a61"), justified as "verified 2026-09-16... do not
# derive this from $tenantDid" - that verification predated forwardmeasure-openworkflow's own
# 2026-09-18 DID-first correction and the later database-per-tenant redesign, and was never
# revisited after either landed. TenantId is always TenantId.forDid($tenantDid)
# (UUID.nameUUIDFromBytes over the DID's UTF-8 bytes) - confirmed independently, and confirmed to
# NOT equal the old literal (which is a random type-4 UUID, never the output of forDid for any
# input). No tenants[].id field exists anymore; nothing in this platform needs the literal UUID at
# Helm-render time - see forwardmeasure-openworkflow's own docs/tenant-provisioning-did-first-fix-
# 2026-09-18.md for the derivation this repo's own tenants[] block must never duplicate again.
gcp:
  dnsServiceAccountEmail: openworkflow-prod-dns@genai-llm-393115.iam.gserviceaccount.com
  externalSecretsServiceAccountEmail: openworkflow-prod-eso@genai-llm-393115.iam.gserviceaccount.com
  modelServiceAccountEmail: openworkflow-prod-model-svc@genai-llm-393115.iam.gserviceaccount.com
  modelCacheBucket: genai-llm-393115-openworkflow-prod-model-cache
  keycloakServiceAccountEmail: openworkflow-prod-keycloak@genai-llm-393115.iam.gserviceaccount.com
  supersetServiceAccountEmail: openworkflow-prod-superset@genai-llm-393115.iam.gserviceaccount.com

gateway:
  acmeEmail: pn@forwardmeasure.com

secretStore:
  # Cluster-specific - see base.yaml.gotmpl's comment on why these aren't
  # declared there. Values are keys into this cluster's own
  # platform-secrets/gcp/openworkflow-prod.credentials.yaml.gotmpl (fake
  # ClusterSecretStore provider, deliberately not real GCP Secret Manager -
  # see that file's own header). Real values still come from GCP Secret
  # Manager, fetched live via `gcloud` at render time in that same file.
  remoteKeys:
    # This cluster's store holds the registry server and auth separately (split 2026-09-16), not a
    # pre-assembled .dockerconfigjson - platform-secrets composes it from these two.
    dockerRegistryServer: platform-container-registry-server
    dockerRegistryAuth: platform-container-registry-auth
    openworkflowRuntimeDatabasePassword: platform-openworkflow-database-password
    openworkflowAdministratorDatabasePassword: platform-openworkflow-database-administrator-password
    # Runtime roles provisioned by forwardmeasure-openworkflow's entity-intelligence-migrations /
    # decision-engine-migrations Jobs (delivered into openworkflowCredentialsSecret).
    entityIntelligenceRuntimeDatabasePassword: platform-entity-intelligence-runtime-database-password
    decisionEngineRuntimeDatabasePassword: platform-decision-engine-runtime-database-password
