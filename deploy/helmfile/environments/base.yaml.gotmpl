# Cross-repository values (domain, gateway IP/hostnames, shared namespaces, identity realm/client,
# Kafka endpoint, Gateway API version, platform-delivered Secret names, cloud facts) are NOT set in
# this repository's environment files - they come from ../shared/ via shared-aliases.yaml.gotmpl,
# loaded after every file here. See ../shared/common.yaml.gotmpl.
# No cloud selected at this tier - see environments/gcp.yaml for the
# cloud-wide layer and environments/gcp-openworkflow-prod.yaml.gotmpl (or
# gcp-greenfield-example.yaml) for a real cluster's values. cloudProvider
# drives which cloud-specific release overlays render (see helmfiles/*
# $cloud derivation) - "" means none of them do.
cloudProvider: ""

# Placeholder tenant DID for the service clients below, from the shared layer's placeholder cluster.
# {{- $tenantDid := (index (tpl (readFile "../shared/clusters/base.yaml.gotmpl") (dict) | fromYaml).platform.tenants 0).did }}
# Namespaces used only by this repository. Shared ones (openworkflow, istio, keycloak, kafka,
# openSearch, valkey, dataStreaming, entityIntelligence, decisionEngine) come from the shared layer.
namespaces:
  platform: forwardmeasure-platform
  certManager: cert-manager
  externalSecrets: external-secrets
  strimzi: strimzi-operator
  registry: apicurio-registry
  kserve: kserve
  knativeOperator: knative-operator
  knativeServing: knative-serving
  knativeEventing: knative-eventing
  modelServing: kserve-serving
  docling: docling-serve
  superset: superset
  opa: opa

gateway:
  name: platform-gateway
  className: istio
  replicaCount: 2
  # loadBalancerIp and every *Host come from the shared layer (clusters/<env>.yaml.gotmpl).
  acmeEmail: platform-owner@example.com
  # clusterIssuer deliberately not set here - it's a cloud-specific ACME
  # DNS-01 solver name (letsencrypt-gcp-dns for GCP's Cloud DNS solver, a
  # different solver/name entirely on another cloud). Set by
  # environments/gcp.yaml (or an equivalent future cloud tier), not base.

secretStore:
  # Matches the forwardmeasure/platform-secrets chart's own default
  # (clusterSecretStore.enabled: false, name: fake-secret-store) - same
  # "fake for now" state data-fabric runs today with this identical chart.
  # A real environment's values layer overrides this name (to
  # google-secret-manager) alongside an explicit clusterSecretStore.provider
  # block when migrating off the fake store - see platform-secrets.yaml.gotmpl.
  name: fake-secret-store
  refreshInterval: 1h
  serviceAccountName: external-secrets
  remoteKeys:
    dockerConfig: platform-container-registry-dockerconfigjson
    keycloakDatabaseUsername: platform-keycloak-database-username
    keycloakDatabasePassword: platform-keycloak-database-password
    keycloakDatabaseUrl: platform-keycloak-database-url
    keycloakAdminUsername: platform-keycloak-admin-username
    keycloakAdminPassword: platform-keycloak-admin-password
    keycloakBootstrapPassword: platform-keycloak-bootstrap-password
    keycloakConfidentialClientSecret: platform-keycloak-confidential-client-secret
    openworkflowClientSecret: platform-openworkflow-client-secret
    openSearchUsername: platform-opensearch-admin-username
    openSearchPassword: platform-opensearch-admin-password
    openSearchPasswordHash: platform-opensearch-admin-password-hash
    openSearchCookie: platform-opensearch-admin-cookie
    huggingFaceToken: platform-huggingface-token
    supersetSecretKey: platform-superset-secret-key
    # Store the complete SQLAlchemy URI so private IP, public IP and verified
    # TLS Cloud SQL connections all use the same deployment contract.
    supersetDatabaseUri: platform-superset-database-uri
    supersetDatabaseHost: platform-superset-database-host
    supersetDatabasePort: platform-superset-database-port
    supersetDatabaseName: platform-superset-database-name
    supersetDatabaseUsername: platform-superset-database-username
    supersetDatabasePassword: platform-superset-database-password
    supersetAdminUsername: platform-superset-admin-username
    supersetAdminPassword: platform-superset-admin-password
    supersetAdminEmail: platform-superset-admin-email
    valkeyPassword: platform-valkey-password
    # openworkflowRuntimeDatabasePassword/openworkflowAdministratorDatabasePassword
    # deliberately NOT declared here - their real Secret Manager names are
    # keyed on openworkflow-k8s-setup's Terraform `var.name` (e.g.
    # "openworkflow-prod-openworkflow-runtime"), which is per-cluster, not a
    # fixed platform-wide convention like every other key above. A prior,
    # invented "platform-openworkflow-database-password" name here pointed at
    # a secret that never existed (confirmed via `gcloud secrets describe` -
    # NOT_FOUND) - real names belong in each real cluster's own environment
    # file. See environments/gcp-openworkflow-prod.yaml.gotmpl.

# realm, publicClientId, openworkflowCredentialsSecret, dataStreamingCredentialsSecret and
# entityIntelligenceCredentialsSecret come from the shared layer (see shared-aliases.yaml.gotmpl).
identity:
  displayName: ForwardMeasure
  # keycloak.v2 is Keycloak's own built-in theme - matches
  # imageVersions.keycloak now pointing at the stock quay.io/keycloak/keycloak
  # image, not a custom-themed one. A prior "forwardmeasure" theme name here
  # only existed in a never-built, never-committed custom image
  # (forwardmeasure-platform-operations/operations-keycloak-theme) - dropped,
  # not something in actual use.
  loginTheme: keycloak.v2
  confidentialClientId: superset
  databaseSecret: keycloak-db-credentials
  adminSecret: keycloak-admin-credentials
  bootstrapSecret: keycloak-bootstrap-admin-user-credentials
  clientSecret: keycloak-realm-client-secrets
  # Matches openworkflow-k8s-setup/terraform/gcp's
  # var.database_administrator_username default - a fixed convention, not a
  # secret. Used only by forwardmeasure-openworkflow's migrations Job to
  # create/rotate the runtime role and apply schema migrations; never granted
  # to a runtime workload (see openworkflow-k8s-setup/docs/operations.md's
  # "Database role provisioning" section).
  databaseAdministratorUsername: forwardmeasure_admin
  # Exactly one tenant-bound SERVICE client per tenant - scripts/preflight.sh enforces it. This used
  # to also declare an example OKS operation-adapter client for the same placeholder tenant, which
  # made preflight fail for this environment.
  serviceClients:
    # forwardmeasure-openworkflow's own confidential client - used by
    # openworkflow-operation-adapter-* for authorization decisions
    # (OPENWORKFLOW_AUTHORIZATION_CLIENT_ID defaults to "openworkflow", see
    # openworkflow-deployments/operation-adapter/*/application.yaml) and by
    # openworkflow-definition-management-*/openworkflow-execution-management-*
    # (OPENWORKFLOW_CLIENT_SECRET). Previously missing entirely - nothing in
    # this realm created a client literally named "openworkflow", even
    # though platform-secrets already tried to sync an OPENWORKFLOW_CLIENT_SECRET
    # value (wrongly reusing Superset's own confidential-client secret).
    - clientId: openworkflow
      name: OpenWorkflow Service Client
      secretKey: OPENWORKFLOW_CLIENT_SECRET
      secretRemoteKey: platform-openworkflow-client-secret
      # tenant-provisioning's TenantOrganizationReconciler/HttpKeycloakOrganizationAdmin owns
      # this client's own authz resources/scopes/policies/permissions (the capability-pack
      # reconciliation) - without this, /authz/resource-server/* 404s for the client.
      authorizationServicesEnabled: true
      realmRoles: [workflow-author, workflow-execution-controller, workflow-auditor, workflow-administrator]
      audiences: [openworkflow-api]
      claims:
        tenant_did: {{ $tenantDid | quote }}
        actor_did: {{ printf "%s:actors:openworkflow" $tenantDid | quote }}
        actor_type: SERVICE
  tlsSecret: keycloak-server-tls
  replicas: 2

# tenantHost/tenantDid/actorDid and tenants[] come from the shared layer's cluster file (see
# shared-aliases.yaml.gotmpl), derived from each tenant's alias and the environment's domain.
bootstrapIdentity:
  actorType: HUMAN


# clusterName/bootstrapServers come from the shared layer.
kafka:
  # Was 4.0.0 - not a version the deployed Strimzi operator (1.2.0) supports
  # at all (confirmed via the Kafka CR's own status condition:
  # UnsupportedKafkaVersionException, "Supported versions are: [4.2.0,
  # 4.2.1, 4.3.0, 4.3.1]" - no broker pods were ever created for it).
  version: "4.3.1"
  controllers: 3
  brokers: 3
  controllerStorage: 20Gi
  brokerStorage: 100Gi

registry:
  name: platform-registry
  replicas: 2
  uiEnabled: true

openSearch:
  replicas: 3
  storage: 100Gi
  javaOpts: -Xms4g -Xmx4g
  credentialsSecret: opensearch-admin-credentials
  # entityIntelligenceCredentialsSecret comes from the shared layer.

models:
  cacheSize: 512Gi
  cachePvc: model-cache-pvc
  cacheServiceAccount: model-cache-sa
  docling:
    mode: cpu
    pipeline: standard
    storage: 64Gi
  ner:
    enabled: true
  relationshipExtraction:
    enabled: true

analytics:
  valkeyReplicas: 3
  supersetReplicas: 2
  supersetWorkers: 2

features:
  openWebUi: false

platformDashboard:
  replicas: 2
  minReplicas: 2
  maxReplicas: 6
  probeTimeout: PT2S
  observationTtl: PT10S
  resources:
    requests: {cpu: 100m, memory: 256Mi}
    limits: {memory: 768Mi}

chartSources:
  # Use reviewed source until 0.1.4 is published.
  openSearch:
    mode: local
    chart: ../../../../helm-charts/charts/opensearch-cluster-helm-chart/helm-chart-sources
  keycloak:
    mode: local
    chart: ../../../../helm-charts/charts/keycloak-helm-chart/helm-chart-sources
