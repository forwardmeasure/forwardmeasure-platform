<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.forwardmeasure.platform</groupId>
    <artifactId>forwardmeasure-platform</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>forwardmeasure-keycloak-theme</artifactId>
  <name>ForwardMeasure Keycloak Theme</name>
  <description>Shared ForwardMeasure login experience and immutable Keycloak image layer</description>

  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>build-keycloak-image</id>
                <phase>package</phase>
                <goals><goal>build</goal></goals>
              </execution>
            </executions>
            <configuration>
              <images>
                <image>
                  <name>${container-image.registry}/${container-image.group}/forwardmeasure-keycloak:${container-image.tag}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>src/main/docker/Dockerfile</dockerFile>
                    <args>
                      <KEYCLOAK_VERSION>${keycloak.version}</KEYCLOAK_VERSION>
                      <KEYCLOAK_IMAGE_DIGEST>${keycloak.image.digest}</KEYCLOAK_IMAGE_DIGEST>
                    </args>
                  </build>
                </image>
              </images>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>container-image-push</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>push-keycloak-image</id>
                <phase>package</phase>
                <goals><goal>push</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
