<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.4.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.4.0 https://maven.apache.org/xsd/build-cache-config-1.4.0.xsd">
  <configuration>
    <enabled>true</enabled>
    <hashAlgorithm>SHA-256</hashAlgorithm>
    <remote enabled="false"/>
    <local><maxBuildsCached>3</maxBuildsCached></local>
    <attachedOutputs>
      <dirNames>
        <dirName>classes</dirName>
        <dirName>test-classes</dirName>
        <dirName>generated-sources</dirName>
        <dirName>generated-test-sources</dirName>
        <dirName>generated-typescript</dirName>
        <dirName>quarkus-app</dirName>
      </dirNames>
    </attachedOutputs>
  </configuration>
  <input>
    <global>
      <!-- Include schemas, migrations, frontend sources, lockfiles and Docker inputs. -->
      <glob>*</glob>
      <includes><include>src</include></includes>
      <excludes>
        <exclude>src/main/webapp/node_modules</exclude>
        <exclude>src/main/webapp/build</exclude>
        <exclude>src/main/webapp/dist</exclude>
        <exclude>src/main/webapp/test-results</exclude>
        <exclude>src/main/webapp/playwright-report</exclude>
      </excludes>
    </global>
  </input>
  <executionControl>
    <runAlways>
      <plugins>
        <!-- Cached compilation must not impersonate fresh verification or publication. -->
        <!-- Compiler goals also register generated source roots and reactor artifacts. Their
             incremental checks may reuse restored classes, but Maven still needs those effects. -->
        <plugin artifactId="maven-compiler-plugin"/>
        <plugin artifactId="build-helper-maven-plugin"/>
        <!-- OpenAPI generation registers source roots as a lifecycle side effect. Cached files
             alone cannot register them. Its unpack/copy inputs must also be materialized. -->
        <plugin artifactId="openapi-generator-maven-plugin"/>
        <plugin artifactId="maven-dependency-plugin"/>
        <!-- Regeneration overwrites corrected frontend packages/models. Reapply overlays and
             copy the corrected resources even when compilation artifacts came from cache. -->
        <plugin artifactId="maven-resources-plugin"/>
        <plugin artifactId="maven-surefire-plugin"/>
        <plugin artifactId="maven-failsafe-plugin"/>
        <plugin artifactId="maven-install-plugin"/>
        <plugin artifactId="maven-deploy-plugin"/>
        <plugin artifactId="maven-enforcer-plugin"/>
        <plugin artifactId="forwardmeasure-platform-policy-maven-plugin"/>
        <plugin artifactId="spotless-maven-plugin"/>
        <plugin artifactId="apache-rat-plugin"/>
        <plugin artifactId="duplicate-finder-maven-plugin"/>
        <plugin artifactId="jacoco-maven-plugin"/>
        <plugin artifactId="docker-maven-plugin"/>
        <plugin artifactId="jib-maven-plugin"/>
        <plugin artifactId="quarkus-maven-plugin"/>
        <plugin artifactId="spring-boot-maven-plugin"/>
        <plugin artifactId="micronaut-maven-plugin"/>
        <plugin artifactId="frontend-maven-plugin"/>
        <plugin artifactId="exec-maven-plugin"/>
        <plugin artifactId="flatten-maven-plugin"/>
      </plugins>
    </runAlways>
    <reconcile>
      <plugins>
        <plugin artifactId="maven-compiler-plugin" goal="compile">
          <reconciles>
            <reconcile propertyName="skipMain"/>
            <reconcile propertyName="release"/>
            <reconcile propertyName="compilerJdk" expression="${java.version}"/>
            <reconcile propertyName="compilerVendor" expression="${java.vendor}"/>
            <reconcile propertyName="compilerArchitecture" expression="${os.arch}"/>
          </reconciles>
        </plugin>
        <plugin artifactId="maven-compiler-plugin" goal="testCompile">
          <reconciles>
            <reconcile propertyName="skip"/>
            <reconcile propertyName="release"/>
            <reconcile propertyName="compilerJdk" expression="${java.version}"/>
            <reconcile propertyName="compilerVendor" expression="${java.vendor}"/>
            <reconcile propertyName="compilerArchitecture" expression="${os.arch}"/>
          </reconciles>
        </plugin>
      </plugins>
    </reconcile>
  </executionControl>
</cache>
